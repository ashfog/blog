{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashfog.com/schemas/daily.schema.json",
  "title": "ASHFOG Global Daily Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "edition",
    "editionDate",
    "timezone",
    "cutoffAt",
    "generatedAt",
    "runId",
    "title",
    "description",
    "qualityShortfallReason",
    "dailyAnalysis",
    "stories",
    "research"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "enum": [
        "Asia/Shanghai",
        "America/New_York"
      ]
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "qualityShortfallReason": {
      "type": "string",
      "maxLength": 500
    },
    "heroImageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "dailyAnalysis": {
      "$ref": "#/$defs/dailyAnalysis"
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 46,
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "research": {
      "$ref": "#/$defs/research"
    },
    "language": {
      "const": "en"
    },
    "edition": {
      "const": "global"
    },
    "windowStartAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "dailyAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "signalIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 300,
          "maxLength": 3000
        },
        "signalIds": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "position",
        "kind",
        "highlight",
        "region",
        "category",
        "topics",
        "company",
        "ecosystem",
        "openSource",
        "mediaOnly",
        "headline",
        "summary",
        "whyItMatters",
        "source",
        "factualClaims",
        "communityCheck",
        "score",
        "materialUpdate",
        "windowException"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "news",
            "community"
          ]
        },
        "highlight": {
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          }
        },
        "company": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "ecosystem": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "openSource": {
          "type": "boolean"
        },
        "mediaOnly": {
          "type": "boolean"
        },
        "headline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "minLength": 80,
          "maxLength": 1600
        },
        "whyItMatters": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "factualClaims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "communityCheck": {
          "$ref": "#/$defs/communityCheck"
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "materialUpdate": {
          "type": "string",
          "maxLength": 300
        },
        "windowException": {
          "type": "string",
          "maxLength": 300
        },
        "imageId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "region": {
          "enum": [
            "global",
            "china",
            "north-america",
            "europe",
            "asia-pacific",
            "other"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tier",
        "url",
        "sourceLanguage",
        "publishedAt",
        "updatedAt",
        "evidenceLabel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidenceLabel": {
          "$ref": "#/$defs/evidenceLabel"
        },
        "sourceLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceUrl",
        "evidenceLabel"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "evidenceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "evidenceLabel": {
          "$ref": "#/$defs/evidenceLabel"
        }
      }
    },
    "communityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "platformsAttempted",
        "platformsUnavailable",
        "signals"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "no_relevant_signal",
            "unavailable",
            "not_applicable"
          ]
        },
        "platformsAttempted": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "platformsUnavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "signals": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/communitySignal"
          }
        }
      }
    },
    "communitySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "retrievedAt",
        "authorRole",
        "evidenceLabel",
        "finding",
        "configuration",
        "adopted"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorRole": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "evidenceLabel": {
          "$ref": "#/$defs/evidenceLabel"
        },
        "finding": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500
        },
        "configuration": {
          "type": "string",
          "maxLength": 500
        },
        "adopted": {
          "type": "boolean"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceStrength",
        "relevance",
        "novelty",
        "practicalUtility",
        "impact",
        "communitySignal",
        "total"
      ],
      "properties": {
        "evidenceStrength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "relevance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "novelty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "practicalUtility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "communitySignal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceScan",
        "collectedUrls",
        "excludedCandidates",
        "unavailableSources",
        "warnings"
      ],
      "properties": {
        "collectedUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "excludedCandidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excludedCandidate"
          }
        },
        "unavailableSources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          }
        },
        "sourceScan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/sourceScanEntry"
          }
        },
        "seriousCandidateCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "excludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "title",
        "url",
        "reason"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "reason": {
          "enum": [
            "duplicate",
            "stale",
            "weak-evidence",
            "low-relevance",
            "marketing-only",
            "unverifiable",
            "lower-priority"
          ]
        },
        "score": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "evidenceLabel": {
      "enum": [
        "officially_stated",
        "maintainer_confirmed",
        "multiple_users_report",
        "single_community_test",
        "community_discussion_suggests",
        "not_independently_verified"
      ]
    },
    "sourceScanEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "status",
        "itemsFetched",
        "duplicatesRemoved",
        "selectedCount",
        "failureReason"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "status": {
          "enum": [
            "collected",
            "empty",
            "unavailable",
            "not-run"
          ]
        },
        "itemsFetched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "itemsOnEditionDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "duplicatesRemoved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "selectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "failureReason": {
          "type": "string",
          "maxLength": 300
        },
        "itemsInWindow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    }
  }
}
