{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashfog.com/schemas/daily.schema.json",
  "title": "ASHFOG Daily Editorial Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "edition",
    "editionDate",
    "timezone",
    "windowStartAt",
    "cutoffAt",
    "generatedAt",
    "runId",
    "title",
    "description",
    "article",
    "signals",
    "research"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "language": { "const": "en" },
    "edition": { "const": "global" },
    "editionDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "const": "America/New_York" },
    "windowStartAt": { "type": "string", "format": "date-time" },
    "cutoffAt": { "type": "string", "format": "date-time" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "minLength": 8, "maxLength": 120 },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "description": { "type": "string", "minLength": 20, "maxLength": 320 },
    "heroImageId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "article": { "$ref": "#/$defs/article" },
    "signals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 46,
      "items": { "$ref": "#/$defs/signal" }
    },
    "research": { "$ref": "#/$defs/research" }
  },
  "$defs": {
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthesis", "sections", "otherSignalIds"],
      "properties": {
        "synthesis": { "$ref": "#/$defs/synthesis" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/articleSection" }
        },
        "otherSignalIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signalId" }
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "signalIds"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 120 },
        "body": { "type": "string", "minLength": 300, "maxLength": 3000 },
        "signalIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signalId" }
        }
      }
    },
    "articleSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "kicker", "title", "body", "signalIds"],
      "properties": {
        "id": { "$ref": "#/$defs/signalId" },
        "position": { "type": "integer", "minimum": 1, "maximum": 7 },
        "kicker": { "type": "string", "minLength": 2, "maxLength": 60 },
        "title": { "type": "string", "minLength": 4, "maxLength": 150 },
        "body": { "type": "string", "minLength": 300, "maxLength": 5000 },
        "signalIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signalId" }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "position",
        "origin",
        "region",
        "category",
        "topics",
        "openSource",
        "headline",
        "brief",
        "source",
        "communityVoices"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/signalId" },
        "eventId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
        },
        "position": { "type": "integer", "minimum": 1, "maximum": 46 },
        "origin": { "enum": ["news", "community"] },
        "region": {
          "enum": ["global", "china", "north-america", "europe", "asia-pacific", "other"]
        },
        "category": { "type": "string", "minLength": 2, "maxLength": 40 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$" }
        },
        "openSource": { "type": "boolean" },
        "headline": { "type": "string", "minLength": 4, "maxLength": 180 },
        "brief": { "type": "string", "minLength": 80, "maxLength": 1000 },
        "source": { "$ref": "#/$defs/source" },
        "communityVoices": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/communityVoice" }
        },
        "imageId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        }
      }
    },
    "communityVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source"],
      "properties": {
        "summary": { "type": "string", "minLength": 40, "maxLength": 700 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "signalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "sourceLanguage", "publishedAt", "updatedAt", "evidenceLabel"],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 80 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "url": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidenceLabel": { "$ref": "#/$defs/evidenceLabel" },
        "sourceLanguage": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceScan", "warnings"],
      "properties": {
        "sourceScan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/sourceScanEntry" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 300 }
        }
      }
    },
    "evidenceLabel": {
      "enum": [
        "officially_stated",
        "maintainer_confirmed",
        "multiple_users_report",
        "single_community_test",
        "community_discussion_suggests",
        "not_independently_verified"
      ]
    },
    "sourceScanEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "status", "itemsFetched", "itemsInWindow", "duplicatesRemoved", "selectedCount", "failureReason"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
        "status": { "enum": ["collected", "empty", "unavailable", "not-run"] },
        "itemsFetched": { "type": "integer", "minimum": 0, "maximum": 15 },
        "itemsInWindow": { "type": "integer", "minimum": 0, "maximum": 15 },
        "duplicatesRemoved": { "type": "integer", "minimum": 0, "maximum": 15 },
        "selectedCount": { "type": "integer", "minimum": 0, "maximum": 15 },
        "failureReason": { "type": "string", "maxLength": 300 }
      }
    }
  }
}
