{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashfog.com/schemas/daily.schema.json",
  "title": "AshFog Daily Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "editionDate",
    "timezone",
    "cutoffAt",
    "generatedAt",
    "runId",
    "title",
    "description",
    "qualityShortfallReason",
    "dailyAnalysis",
    "stories",
    "research"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": { "const": "Asia/Shanghai" },
    "cutoffAt": { "type": "string", "format": "date-time" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runId": { "type": "string", "minLength": 8, "maxLength": 120 },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "description": { "type": "string", "minLength": 20, "maxLength": 240 },
    "qualityShortfallReason": { "type": "string", "maxLength": 300 },
    "heroImageId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "dailyAnalysis": { "$ref": "#/$defs/dailyAnalysis" },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/story" }
    },
    "research": { "$ref": "#/$defs/research" }
  },
  "$defs": {
    "dailyAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "signalIds"],
      "properties": {
        "title": { "type": "string", "minLength": 4, "maxLength": 120 },
        "body": { "type": "string", "minLength": 120, "maxLength": 3000 },
        "signalIds": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "position",
        "kind",
        "highlight",
        "category",
        "topics",
        "company",
        "ecosystem",
        "openSource",
        "mediaOnly",
        "headline",
        "summary",
        "whyItMatters",
        "source",
        "factualClaims",
        "communityCheck",
        "score",
        "materialUpdate",
        "windowException"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
        },
        "position": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["news", "community"] },
        "highlight": { "type": "boolean" },
        "category": { "type": "string", "minLength": 2, "maxLength": 40 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          }
        },
        "company": { "type": ["string", "null"], "maxLength": 80 },
        "ecosystem": { "type": "string", "minLength": 2, "maxLength": 60 },
        "openSource": { "type": "boolean" },
        "mediaOnly": { "type": "boolean" },
        "headline": { "type": "string", "minLength": 4, "maxLength": 180 },
        "summary": { "type": "string", "minLength": 200, "maxLength": 300 },
        "whyItMatters": { "type": "string", "minLength": 70, "maxLength": 100 },
        "source": { "$ref": "#/$defs/source" },
        "factualClaims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/claim" }
        },
        "communityCheck": { "$ref": "#/$defs/communityCheck" },
        "score": { "$ref": "#/$defs/score" },
        "materialUpdate": { "type": "string", "maxLength": 300 },
        "windowException": { "type": "string", "maxLength": 300 },
        "imageId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tier",
        "url",
        "publishedAt",
        "updatedAt",
        "evidenceLabel"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 80 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "tier": { "enum": ["A", "B", "C"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidenceLabel": { "$ref": "#/$defs/evidenceLabel" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidenceUrl", "evidenceLabel"],
      "properties": {
        "text": { "type": "string", "minLength": 8, "maxLength": 500 },
        "evidenceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "evidenceLabel": { "$ref": "#/$defs/evidenceLabel" }
      }
    },
    "communityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "platformsAttempted",
        "platformsUnavailable",
        "signals"
      ],
      "properties": {
        "status": {
          "enum": [
            "checked",
            "no_relevant_signal",
            "unavailable",
            "not_applicable"
          ]
        },
        "platformsAttempted": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "platformsUnavailable": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "signals": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/communitySignal" }
        }
      }
    },
    "communitySignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "retrievedAt",
        "authorRole",
        "evidenceLabel",
        "finding",
        "configuration",
        "adopted"
      ],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "authorRole": { "type": "string", "minLength": 2, "maxLength": 80 },
        "evidenceLabel": { "$ref": "#/$defs/evidenceLabel" },
        "finding": { "type": "string", "minLength": 8, "maxLength": 500 },
        "configuration": { "type": "string", "maxLength": 500 },
        "adopted": { "type": "boolean" }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceStrength",
        "relevance",
        "novelty",
        "practicalUtility",
        "impact",
        "communitySignal",
        "total"
      ],
      "properties": {
        "evidenceStrength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "relevance": { "type": "integer", "minimum": 0, "maximum": 5 },
        "novelty": { "type": "integer", "minimum": 0, "maximum": 5 },
        "practicalUtility": { "type": "integer", "minimum": 0, "maximum": 5 },
        "impact": { "type": "integer", "minimum": 0, "maximum": 5 },
        "communitySignal": { "type": "integer", "minimum": 0, "maximum": 5 },
        "total": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectedUrls",
        "excludedCandidates",
        "unavailableSources",
        "warnings"
      ],
      "properties": {
        "collectedUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "excludedCandidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/excludedCandidate" }
        },
        "unavailableSources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 300 }
        }
      }
    },
    "excludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "title", "url", "reason"],
      "properties": {
        "eventId": { "type": "string", "minLength": 3, "maxLength": 120 },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "reason": {
          "enum": [
            "duplicate",
            "stale",
            "weak-evidence",
            "low-relevance",
            "marketing-only",
            "unverifiable"
          ]
        }
      }
    },
    "evidenceLabel": {
      "enum": [
        "officially_stated",
        "maintainer_confirmed",
        "multiple_users_report",
        "single_community_test",
        "community_discussion_suggests",
        "not_independently_verified"
      ]
    }
  }
}
