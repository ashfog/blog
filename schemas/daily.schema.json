{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ashfog.com/schemas/daily.schema.json",
  "title": "ASHFOG Global Daily Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "language",
    "edition",
    "editionDate",
    "timezone",
    "cutoffAt",
    "generatedAt",
    "runId",
    "title",
    "description",
    "dailyAnalysis",
    "stories",
    "research"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "editionDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "enum": [
        "Asia/Shanghai",
        "America/New_York"
      ]
    },
    "cutoffAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "heroImageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "dailyAnalysis": {
      "$ref": "#/$defs/dailyAnalysis"
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 46,
      "items": {
        "$ref": "#/$defs/story"
      }
    },
    "research": {
      "$ref": "#/$defs/research"
    },
    "language": {
      "const": "en"
    },
    "edition": {
      "const": "global"
    },
    "windowStartAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "dailyAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "signalIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 300,
          "maxLength": 3000
        },
        "signalIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "position",
        "kind",
        "highlight",
        "region",
        "category",
        "topics",
        "openSource",
        "headline",
        "summary",
        "whyItMatters",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
        },
        "eventId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "news",
            "community"
          ]
        },
        "highlight": {
          "type": "boolean"
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          }
        },
        "openSource": {
          "type": "boolean"
        },
        "headline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 180
        },
        "summary": {
          "type": "string",
          "minLength": 80,
          "maxLength": 1600
        },
        "whyItMatters": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "imageId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "region": {
          "enum": [
            "global",
            "china",
            "north-america",
            "europe",
            "asia-pacific",
            "other"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url",
        "sourceLanguage",
        "publishedAt",
        "updatedAt",
        "evidenceLabel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "url": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidenceLabel": {
          "$ref": "#/$defs/evidenceLabel"
        },
        "sourceLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceScan",
        "warnings"
      ],
      "properties": {
        "sourceScan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/sourceScanEntry"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          }
        }
      }
    },
    "evidenceLabel": {
      "enum": [
        "officially_stated",
        "maintainer_confirmed",
        "multiple_users_report",
        "single_community_test",
        "community_discussion_suggests",
        "not_independently_verified"
      ]
    },
    "sourceScanEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "status",
        "itemsFetched",
        "duplicatesRemoved",
        "selectedCount",
        "failureReason"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "status": {
          "enum": [
            "collected",
            "empty",
            "unavailable",
            "not-run"
          ]
        },
        "itemsFetched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "itemsOnEditionDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "duplicatesRemoved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "selectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "failureReason": {
          "type": "string",
          "maxLength": 300
        },
        "itemsInWindow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        }
      }
    }
  }
}
