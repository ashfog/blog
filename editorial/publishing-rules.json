{
  "version": 7,
  "timezone": "America/New_York",
  "selection": {
    "combineRelevanceAndEventDeduplication": true,
    "deduplicateByEventContent": true,
    "preferOfficialSourceWithinEvent": true,
    "importanceScoring": false,
    "safetyMaxStories": 46,
    "overflowOrder": "newest-first"
  },
  "contentLengths": {
    "signalBriefWords": {
      "min": 35,
      "max": 90
    },
    "communityVoiceWords": {
      "min": 25,
      "max": 80
    }
  },
  "article": {
    "title": {
      "minWords": 6,
      "maxWords": 14,
      "forbidBrandOrDateTemplate": true
    },
    "sections": {
      "min": 1,
      "max": 7
    },
    "sectionWords": {
      "min": 180,
      "max": 450
    },
    "sectionMinParagraphs": 2,
    "targetTotalWords": {
      "min": 1500,
      "max": 2500
    },
    "synthesis": {
      "minSignalIds": 3,
      "minParagraphs": 2,
      "minWords": 150,
      "targetWords": {
        "min": 150,
        "max": 250
      }
    }
  },
  "collection": {
    "windowMode": "rolling-hours",
    "windowBoundary": "(windowStartAt, cutoffAt]",
    "schemaVersion3RequiredFrom": "2026-08-01",
    "windowHours": 24,
    "timezone": "America/New_York",
    "cutoffLocalTime": "09:30",
    "perSourceLatestLimit": 15,
    "useAvailableWhenFewer": true,
    "outsideWindowBackfill": false,
    "requireAllRegisteredSourcesAttempted": true
  },
  "schedule": {
    "localTime": "09:30",
    "timezone": "America/New_York"
  }
}
