        "max": 180
      },
      "whyItMattersWords": {
        "min": 50,
        "max": 80
      }
    },
    "community": {
      "summaryWords": {
        "min": 80,
        "max": 130
      },
      "whyItMattersWords": {
        "min": 35,
        "max": 60
      }
    }
  },
  "presentation": {
    "highlights": {
      "min": 1,
      "max": 5
    }
  },
  "analysis": {
    "minSignalIds": 3,
    "minParagraphs": 2,
    "minWords": 160,
    "targetWords": {
      "min": 200,
      "max": 350
    }
