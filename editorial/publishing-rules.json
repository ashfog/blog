{
  "version": 5,
  "timezone": "America/New_York",
  "selection": {
    "combineRelevanceAndEventDeduplication": true,
    "deduplicateByEventContent": true,
    "preferOfficialSourceWithinEvent": true,
    "importanceScoring": false,
    "safetyMaxStories": 46,
