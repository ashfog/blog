{
  "version": 6,
  "last_reviewed": "2026-07-29",
  "timezone": "America/New_York",
  "tiers": {
    "A": "Primary facts: official announcements, repositories, releases, specifications, model cards, and papers.",
    "B": "Engineering evidence: reproducible benchmarks, practitioner reports, technical analysis, and community threads.",
    "C": "Discovery radar: newsletters, aggregators, and social signals that must lead back to stronger evidence."
  },
  "operating_rules": {
    "prefer_machine_readable_access": true,
    "use_conditional_requests": true,
    "respect_terms_and_rate_limits": true,
    "community_access_is_best_effort": true,
    "community_outage_is_blocking": false,
    "tier_c_must_resolve_to_stronger_evidence": true,
    "do_not_bypass_authentication_or_paywalls": true,
    "candidate_collection_has_no_global_cap": true,
    "regional_coverage_is_not_a_publication_quota": true,
    "items_per_source_is_a_hard_maximum": true,
    "record_every_source_attempt": true,
    "scan_all_enabled_sources_each_run": true
  },
  "access_profiles": {
    "official-web": {
      "method": "web",
      "authentication": "none unless required by the publisher",
      "rate_policy": "low-frequency targeted reads; cache discovered URLs",
      "fallback": "official RSS, changelog, repository, or release page"
    },
    "github-rest": {
      "method": "GitHub REST or GraphQL",
      "authentication": "recommended",
      "rate_policy": "honor response headers; use ETag/If-None-Match and targeted repository queries",
      "fallback": "public repository release or discussion page"
    },
    "hn-api": {
      "method": "official Firebase API",
      "authentication": "none",
      "endpoint": "https://hacker-news.firebaseio.com/v0/",
      "rate_policy": "cache item responses and request only relevant threads",
      "fallback": "public Hacker News thread"
    },
    "hf-hub": {
      "method": "Hugging Face Hub API or hf CLI",
      "authentication": "optional for public resources",
      "rate_policy": "use structured paper/discussion commands and targeted repository reads",
      "fallback": "public paper, model card, or discussion page"
    },
    "arxiv-api": {
      "method": "arXiv API or category listing",
      "authentication": "none",
      "endpoint": "https://export.arxiv.org/api/query",
      "rate_policy": "query narrow categories and cache metadata",
      "fallback": "arXiv abstract page"
    },
    "reddit-targeted": {
      "method": "approved Reddit API or manual targeted search",
      "authentication": "as required",
      "rate_policy": "comply with Reddit Developer/Data API terms and rate limits",
      "fallback": "record unavailable; use GitHub/HN/Hugging Face evidence"
    },
    "x-targeted": {
      "method": "official X API or manual targeted search",
      "authentication": "usually required",
      "rate_policy": "honor endpoint and plan limits; stop on 429",
      "fallback": "record unavailable; use author repository, paper, or official announcement"
    },
    "newsletter-radar": {
      "method": "public newsletter archive or subscribed edition",
      "authentication": "do not bypass subscriber access",
      "rate_policy": "check at source cadence; use only for discovery",
      "fallback": "none"
    }
  },
  "kind_access_defaults": {
    "official": "official-web",
    "official-community": "hf-hub",
    "official-and-repository": "github-rest",
    "changelog": "official-web",
    "repository-releases": "github-rest",
