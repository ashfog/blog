{
  "version": 2,
  "lastReviewed": "2026-07-29",
  "timezone": "Asia/Shanghai",
  "purpose": "Machine-readable ordered collection routes and deterministic fallbacks for every registered source.",
  "routeTypes": [
    "rss",
    "json-api",
    "sitemap",
    "connected-github",
    "web-index",
    "date-archive",
    "indexed-search",
    "cli"
  ],
  "statusSemantics": {
    "collected": "At least one route succeeded and exposed one or more entries on the edition date.",
    "empty": "At least one route succeeded and exposed a trustworthy dated listing, but it contained no edition-day entries.",
    "unavailable": "Every configured route failed, was blocked, required unavailable credentials, or could not expose trustworthy dates.",
    "not-run": "No configured route was attempted. This remains blocking."
  },
  "collectionRules": {
    "tryRoutesInOrder": true,
    "continueAfterRouteFailure": true,
    "stopAfterTrustworthyDatedListing": true,
    "siteRestrictedSearchIsFallbackOnly": true,
    "searchResultMustResolveToCanonicalSource": true,
    "doNotTreatNoSearchResultsAsAccessFailure": true,
    "maxEntriesPerSource": 15,
    "backfillPriorDays": false
  },
  "plans": {
    "openai-news": [
      {
        "type": "rss",
        "url": "https://openai.com/news/rss.xml"
      },
      {
        "type": "web-index",
