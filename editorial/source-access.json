{
  "version": 5,
  "lastReviewed": "2026-08-02",
  "timezone": "America/New_York",
  "purpose": "Machine-readable ordered collection routes and deterministic fallbacks for every registered source in a trailing 24-hour window.",
  "routeTypes": [
    "rss",
    "json-api",
    "sitemap",
    "connected-github",
    "web-index",
    "date-archive",
    "indexed-search",
    "cli"
  ],
  "statusSemantics": {
    "collected": "At least one route succeeded and exposed one or more entries inside the trailing 24-hour window.",
    "empty": "At least one route succeeded and exposed a trustworthy dated listing covering the window, but it contained no in-window entries.",
    "unavailable": "Every configured route failed, was blocked, required unavailable credentials, or could not expose trustworthy dates.",
    "not-run": "No configured route was attempted. This remains blocking."
  },
  "collectionRules": {
    "tryRoutesInOrder": true,
    "continueAfterRouteFailure": true,
    "stopAfterAuthoritativeDatedRouteCoversWindow": true,
    "continueAfterBroadRouteHasNoInWindowEntries": true,
    "stopAfterInScopeEntries": true,
    "metadataFirst": true,
    "fetchBodiesAfterWindowAndScopeFilter": true,
    "fetchOnlyDeduplicatedEventRepresentatives": true,
    "siteRestrictedSearchIsFallbackOnly": true,
    "searchResultMustResolveToCanonicalSource": true,
    "doNotTreatNoSearchResultsAsAccessFailure": true,
    "exactTimestampWindow": true,
    "windowBoundary": "(windowStartAt, cutoffAt]",
    "windowHours": 24,
    "expandWindowDateRoutes": true,
    "deduplicateAcrossWindowDates": true,
    "mergeThenSortFilterAndLimit": true,
    "maxEntriesPerSource": 15,
    "outsideWindowBackfill": false
  },
  "collectionPhases": {
    "metadata": {
      "fields": [
        "sourceId",
        "title",
        "url",
        "publishedAt",
        "updatedAt"
      ],
      "fetchArticleBody": false,
      "applyWindowFilterBeforeBodyFetch": true,
      "applyScopeFilterBeforeBodyFetch": true,
      "applyCheapTitleAndUrlDeduplicationBeforeBodyFetch": true
    },
    "content": {
      "startAfterMetadataFiltering": true,
      "fetchOnlyPotentialEventRepresentatives": true,
      "performContentLevelEventDeduplication": true,
      "preferPrimaryEvidenceWithinEvent": true
    }
  },
  "healthHistory": {
    "lookbackEditions": 14,
    "deriveFrom": "src/content/daily/*.json research.sourceScan",
    "neverSkipRegisteredSource": true,
    "preferMachineReadableRouteThatRecentlySucceeded": true,
    "doNotOpenExpensiveFallbackAfterAuthoritativeEmptyResult": true,
    "treatRepeatedEmptyAsCadenceSignalNotFailure": true
  },
  "adapterProfiles": {
    "official-feed": {
      "preferredRouteTypes": ["rss", "json-api", "sitemap", "date-archive"],
      "bodyPolicy": "selected-event-only"
    },
    "github-repository-search": {
      "preferredRouteTypes": ["connected-github"],
      "timestampFields": ["created_at", "pushed_at", "published_at"],
      "bodyPolicy": "selected-repository-only"
    },
    "github-org-releases": {
      "preferredRouteTypes": ["connected-github"],
      "timestampFields": ["created_at", "pushed_at", "published_at"],
      "allowedMaterialEvents": ["new-repository", "release", "model-card", "material-documentation-update"],
      "bodyPolicy": "material-event-only"
    },
    "community-api": {
      "preferredRouteTypes": ["json-api", "rss"],
      "bodyPolicy": "in-window-candidate-only"
    },
    "china-discovery": {
      "preferredRouteTypes": ["rss", "sitemap", "date-archive", "web-index", "indexed-search"],
      "queryTerms": ["人工智能", "大模型", "智能体", "算力", "芯片", "算法", "数据安全", "模型"],
      "bodyPolicy": "resolved-primary-event-only"
    },
    "x-best-effort": {
      "preferredRouteTypes": ["indexed-search", "web-index"],
      "nativeAccessRequiresAuthenticatedPermittedSession": true,
      "failureIsNonBlocking": true,
      "bodyPolicy": "concrete-in-window-post-only"
    }
  },
  "sourceAdapters": {
    "openai-news": "official-feed",
    "nvidia-developer-blog": "official-feed",
    "github-changelog": "official-feed",
    "phoronix": "official-feed",
    "github-trending": "github-repository-search",
    "hacker-news": "community-api",
    "show-hn": "community-api",
    "reddit-localllama": "community-api",
    "x-curated-experts": "x-best-effort",
    "vercel-ai": "github-org-releases",
    "deepseek-official": "github-org-releases",
    "qwen-official": "github-org-releases",
    "bytedance-seed": "github-org-releases",
    "zai-official": "github-org-releases",
    "moonshot-ai": "github-org-releases",
    "tencent-hunyuan": "github-org-releases",
    "baidu-ernie-paddlepaddle": "github-org-releases",
    "huawei-ascend": "github-org-releases",
    "stepfun-official": "github-org-releases",
    "modelscope-hub": "china-discovery",
    "china-cac": "china-discovery",
    "china-miit": "china-discovery",
    "machine-heart": "china-discovery",
