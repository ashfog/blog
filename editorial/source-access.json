    "github-trending": [
      {
        "type": "connected-github",
        "url": "https://api.github.com/search/repositories",
        "queries": [
          "created:{editionDate} topic:artificial-intelligence",
          "created:{editionDate} topic:llm",
          "pushed:{editionDate} topic:machine-learning"
        ],
        "note": "Primary dated route. Use connected GitHub access, deduplicate repositories, and verify license, release history, and maintainer activity."
      },
      {
        "type": "web-index",
        "url": "https://github.com/trending",
        "note": "Discovery fallback only. The Today page lacks trustworthy per-repository timestamps, so it cannot by itself produce collected or empty status for the edition-day window."
      }
    ],
