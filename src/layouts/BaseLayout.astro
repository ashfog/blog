---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { colorModeStorageKey, directionForLanguage, ogLocale, siteConfig, siteUrl } from "../config/site";
import { getThemeManifest } from "../themes/registry";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  language?: string;
  image?: string;
  type?: "website" | "article";
  pageType?: "WebPage" | "CollectionPage" | "AboutPage";
  noindex?: boolean;
  breadcrumbs?: Array<{
    name: string;
    path: string;
  }>;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
    citations?: string[];
  };
}

const {
  title = `${siteConfig.site.name} — Independent Articles`,
  description = siteConfig.site.description,
  language = siteConfig.site.language,
  image,
  type = "website",
  pageType = "WebPage",
  noindex = false,
  breadcrumbs = [],
  article
} = Astro.props;

const site = Astro.site ?? siteUrl;
const canonical = new URL(Astro.url.pathname, site);
const fullTitle = title.toLocaleLowerCase(siteConfig.site.locale).includes(siteConfig.site.name.toLocaleLowerCase(siteConfig.site.locale))
  ? title
  : `${title} — ${siteConfig.site.name}`;
const imageUrl = image ? new URL(image, site).href : undefined;
const imageMimeType = imageUrl
  ? ({
      ".avif": "image/avif",
      ".gif": "image/gif",
      ".jpeg": "image/jpeg",
      ".jpg": "image/jpeg",
      ".png": "image/png",
      ".webp": "image/webp"
    } as Record<string, string>)[new URL(imageUrl).pathname.match(/\.[a-z0-9]+$/i)?.[0]?.toLowerCase() ?? ""]
  : undefined;
const publisherId = new URL("/#publisher", site).href;
const websiteId = new URL("/#website", site).href;
const webpageId = `${canonical.href}#webpage`;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const activeTheme = getThemeManifest(siteConfig.theme.id);
const publisherType = siteConfig.publisher.type === "person" ? "Person" : "Organization";
const defaultColorMode = siteConfig.theme.defaultColorMode;
const lightThemeColor = activeTheme.themeColors.light;
const darkThemeColor = activeTheme.themeColors.dark;
const documentDirection = directionForLanguage(language);

const graph: Array<Record<string, unknown>> = [
  {
    "@type": publisherType,
    "@id": publisherId,
    name: siteConfig.publisher.name,
    url: new URL("/about", site).href,
    description: siteConfig.site.description,
    ...(siteConfig.publisher.showEmail && siteConfig.publisher.email
      ? { email: `mailto:${siteConfig.publisher.email}` }
      : {})
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: new URL("/", site).href,
    name: siteConfig.site.name,
    description: siteConfig.site.description,
    inLanguage: siteConfig.site.language,
    publisher: { "@id": publisherId }
  },
  {
    "@type": pageType,
    "@id": webpageId,
    url: canonical.href,
    name: fullTitle,
    description,
    inLanguage: language,
    isPartOf: { "@id": websiteId },
    ...(breadcrumbs.length > 1
      ? { breadcrumb: { "@id": `${canonical.href}#breadcrumb` } }
      : {})
  }
];

if (breadcrumbs.length > 1) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical.href}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.path, site).href
    }))
  });
}

if (article) {
  graph.push({
    "@type": "Article",
    "@id": `${canonical.href}#article`,
    mainEntityOfPage: { "@id": webpageId },
    headline: title,
    description,
    datePublished: article.publishedTime,
    dateModified: article.modifiedTime ?? article.publishedTime,
    inLanguage: language,
    isAccessibleForFree: true,
    author: { "@id": publisherId },
    publisher: { "@id": publisherId },
    ...(article.section ? { articleSection: article.section } : {}),
    ...(article.tags?.length ? { keywords: article.tags } : {}),
    ...(article.citations?.length ? { citation: article.citations } : {}),
    ...(imageUrl ? { image: [imageUrl] } : {})
  });
}

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html
  lang={language}
  dir={documentDirection}
  data-site-theme={siteConfig.theme.id}
  style={`--site-accent: ${siteConfig.theme.accentColor}; --site-accent-dark: ${siteConfig.theme.accentColorDark};`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? "noindex,follow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <meta id="site-theme-color" name="theme-color" content={lightThemeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={siteConfig.branding.favicon} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.site.name} RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.site.name} />
    {language === siteConfig.site.language && <meta property="og:locale" content={ogLocale} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && (
      <meta
        property="article:modified_time"
        content={article.modifiedTime ?? article.publishedTime}
      />
    )}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1536" />}
    {imageUrl && <meta property="og:image:height" content="1024" />}
    {imageMimeType && <meta property="og:image:type" content={imageMimeType} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <script type="application/ld+json" set:html={jsonLd}></script>
    <script is:inline define:vars={{ colorModeStorageKey, defaultColorMode, lightThemeColor, darkThemeColor }}>
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      let saved = null;
      try {
        saved = localStorage.getItem(colorModeStorageKey);
      } catch {}
      const configured = defaultColorMode === "system" ? (systemDark ? "dark" : "light") : defaultColorMode;
      const colorMode = saved === "dark" || saved === "light" ? saved : configured;
      document.documentElement.dataset.theme = colorMode;
      document.querySelector("#site-theme-color")?.setAttribute("content", colorMode === "dark" ? darkThemeColor : lightThemeColor);
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
