---
import type { LibraryImage } from "../lib/images";

interface Props {
  image: LibraryImage;
  compact?: boolean;
  priority?: boolean;
}

const { image, compact = false, priority = false } = Astro.props;
---

<figure class:list={["page-artwork", { compact }, `variant-${image.variant}`]}>
  <img
    src={image.src}
    srcset={image.srcset}
    sizes={compact ? "(max-width: 760px) 100vw, 760px" : "(max-width: 1400px) 100vw, 1320px"}
    width={image.width}
    height={image.height}
    alt={image.alt}
    loading={priority ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
  />
</figure>

<style>
  .page-artwork {
    width: 100%;
    height: clamp(280px, 46vw, 610px);
    margin: 0 0 90px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .page-artwork.compact {
    width: min(100%, 760px);
    height: auto;
    margin: 35px 0 5px;
    aspect-ratio: 3 / 2;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .page-artwork {
      height: auto;
      margin-bottom: 60px;
      aspect-ratio: 3 / 2;
    }
  }
</style>
