---
import ArticleCard from "./ArticleCard.astro";
import { getActiveArticleCategories, type ArticleEntry } from "../lib/articles";
import { siteConfig } from "../config/site";

interface Props { articles: ArticleEntry[]; }
const { articles } = Astro.props;
const latest = articles[0];
const recent = articles.slice(1, 9);
const topics = getActiveArticleCategories(articles, 6);
const topicNotes: Record<string, string> = {
  models: "New capabilities, thoughtfully explored",
  agents: "The tools learning to work alongside us",
  research: "Big questions and fresh perspectives",
  "open-source": "Good things built in the open",
  "developer-tools": "A closer look at how we build",
  infrastructure: "The foundations beneath the surface",
  security: "Trust, boundaries and the fine print",
  media: "Stories, sounds and new ways to create",
  design: "The details that change the experience",
  culture: "Ideas that shape the world around us",
  web: "Interesting corners of a connected world"
};
---

<div class="horizon-home page-shell">
  <section class="horizon-hero" aria-labelledby="horizon-title">
    <img class="horizon-landscape"
      src="/images/themes/horizon/landscape-1536.webp"
      srcset="/images/themes/horizon/landscape-640.webp 640w, /images/themes/horizon/landscape-1536.webp 1536w"
      sizes="(max-width: 680px) 100vw, 94vw" width="1536" height="1024"
      alt="" fetchpriority="high" decoding="async" />
    <div class="horizon-hero-copy">
      <span class="horizon-kicker"><span aria-hidden="true">✳</span> A journal for the curious</span>
      <h1 id="horizon-title">A little curiosity.<br /><em>A wider world.</em></h1>
      <p>Ideas, discoveries, and things worth a closer look.<br class="desktop-break" /> Follow a thread. Find something unexpected.</p>
      <div class="horizon-actions">
        <a class="horizon-button" href={latest ? "#latest" : "/articles"}>Explore the journal <span aria-hidden="true">↗</span></a>
        <a class="horizon-button secondary" href="/about">Meet {siteConfig.site.shortName} <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <span class="horizon-field-note"><span aria-hidden="true">◉</span> Independent perspectives · Open horizons</span>
  </section>

  {topics.length > 0 && (
    <nav class="horizon-topic-ribbon" aria-label="Explore popular topics">
      <span>Find your next interest</span>
      <div>{topics.map((topic) => <a href={`/topics/${topic.slug}`}>{topic.label} <span aria-hidden="true">↗</span></a>)}</div>
    </nav>
  )}

  <section id="latest" class="horizon-journal" aria-labelledby="latest-title">
    <div class="horizon-section-heading">
      <div><span class="eyebrow">Fresh from the journal</span><h2 id="latest-title">Something worth your time</h2></div>
      <a class="horizon-text-link" href="/articles">All articles <span aria-hidden="true">↗</span></a>
    </div>
    {latest ? <ArticleCard article={latest} featured priority={false} /> : (
      <p class="horizon-empty">The first field note is still taking shape. Come back soon, or follow the <a href="/rss.xml">RSS feed</a>.</p>
    )}
    {recent.length > 0 && (
      <div class="horizon-recent">
        <div class="horizon-small-heading"><h3>More from {siteConfig.site.shortName}</h3><span>A few paths to follow</span></div>
        <div class="horizon-card-grid">{recent.map((article) => <ArticleCard article={article} grid />)}</div>
      </div>
    )}
  </section>

  <section class="horizon-window" aria-labelledby="window-title">
    <figure>
      <img src="/images/themes/horizon/reading-window-1024.webp"
        srcset="/images/themes/horizon/reading-window-640.webp 640w, /images/themes/horizon/reading-window-1024.webp 1024w"
        sizes="(max-width: 680px) 90vw, 42vw" width="1024" height="1024"
        alt="An open book and a brass telescope on a stone windowsill overlooking a turquoise lake and green mountains."
        loading="lazy" decoding="async" />
    </figure>
    <div>
      <span class="eyebrow">A different point of view</span>
      <h2 id="window-title">Leave a little room<br /><em>for wonder.</em></h2>
      <p>The most interesting things rarely fit in a single category. We follow ideas across technology, creative work, and the wider world—and take the time to understand them.</p>
      <p>Thoughtful writing. Sources you can follow. A new perspective to take with you.</p>
      <a class="horizon-text-link" href="/about">The story behind {siteConfig.site.shortName} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  {topics.length > 0 && (
    <section class="horizon-topics" aria-labelledby="topics-title">
      <div class="horizon-section-heading">
        <div><span class="eyebrow">Follow your interests</span><h2 id="topics-title">Choose a direction</h2></div>
        <a class="horizon-text-link" href="/topics">Every topic <span aria-hidden="true">↗</span></a>
      </div>
      <div class="horizon-topic-grid">
        {topics.map((topic, i) => (
          <a class={`horizon-topic tone-${i % 3}`} href={`/topics/${topic.slug}`}>
            <div class="horizon-topic-top"><span class="horizon-topic-symbol" aria-hidden="true">{["✳", "⌘", "◎", "↗", "◇", "✺"][i]}</span><span>{topic.count} {topic.count === 1 ? "article" : "articles"}</span></div>
            <h3>{topic.label}</h3>
            <p>{topicNotes[topic.slug] ?? "New discoveries and ideas worth exploring"}</p>
            <span class="horizon-topic-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="horizon-follow" aria-labelledby="follow-title">
    <div><span class="eyebrow">Keep a good thing close</span><h2 id="follow-title">A new perspective, at your pace.</h2><p>No daily quota. Just something interesting when it is ready.</p></div>
    <a class="horizon-button" href="/rss.xml">Follow via RSS <span aria-hidden="true">↗</span></a>
  </section>
</div>

<style>
  .horizon-home { padding-top: 20px; }
  .horizon-hero { position: relative; isolation: isolate; min-height: 690px; overflow: hidden; border-radius: 28px; background: #bce8f1; color: #173c43; }
  .horizon-landscape { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 72%; }
  .horizon-hero::before { content: ""; position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, #e6f7f8b3 0%, #e6f7f855 42%, transparent 65%); }
  .horizon-hero-copy { position: relative; max-width: 900px; margin-inline: auto; padding: 54px 24px 200px; text-align: center; }
  .horizon-kicker { display: inline-flex; align-items: center; gap: 9px; padding: 7px 14px; border: 1px solid #ffffff9c; border-radius: 100px; background: #ffffffe0; color: #315b61; font-size: 11px; font-weight: 650; letter-spacing: .11em; text-transform: uppercase; }
  .horizon-kicker > span { color: #53886b; font-size: 18px; line-height: 1; }
  h1 { margin: 22px 0 18px; font-size: clamp(54px, 5.7vw, 86px); font-weight: 520; letter-spacing: -.065em; line-height: 1.03; text-wrap: balance; }
  h1 em { font-family: var(--font-serif); font-weight: 400; letter-spacing: -.06em; color: #21675f; }
  .horizon-hero-copy > p { margin: 0; color: #335760; font-size: 16px; line-height: 1.65; }
  .horizon-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 24px; }
  .horizon-button { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; gap: 24px; padding: 12px 21px; border: 1px solid transparent; border-radius: 100px; background: #176b60; color: #fff; font-size: 13px; font-weight: 550; transition: transform 180ms ease, box-shadow 180ms ease; }
  .horizon-button:hover { transform: translateY(-2px); box-shadow: 0 8px 18px #173c4324; }
  .horizon-button.secondary { border-color: #ffffffb0; background: #ffffffe6; color: #234f50; }
  .horizon-field-note { position: absolute; right: 24px; bottom: 22px; display: flex; gap: 8px; padding: 9px 14px; border: 1px solid #ffffff99; border-radius: 100px; background: #fafff5e8; color: #345147; font-size: 10px; letter-spacing: .035em; }
  .horizon-topic-ribbon { display: flex; align-items: center; gap: 34px; padding: 27px 4px; border-bottom: 1px solid var(--line); }
  .horizon-topic-ribbon > span { color: var(--faint); font-size: 11px; white-space: nowrap; }
  .horizon-topic-ribbon > div { display: flex; flex-wrap: wrap; gap: 10px 24px; }
  .horizon-topic-ribbon a { display: inline-flex; gap: 9px; align-items: center; min-height: 32px; color: var(--muted); font-size: 12px; }
  .horizon-topic-ribbon a:hover { color: var(--accent); }
  .horizon-topic-ribbon a span { color: var(--accent); }
  .horizon-journal, .horizon-topics { padding-top: 86px; scroll-margin-top: 110px; }
  .horizon-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .horizon-section-heading h2 { margin: 14px 0 0; font-size: clamp(30px, 3.2vw, 43px); font-weight: 520; letter-spacing: -.05em; line-height: 1.16; text-wrap: balance; }
  .horizon-text-link { display: inline-flex; align-items: center; gap: 18px; min-height: 44px; color: var(--accent); font-size: 13px; font-weight: 550; }
  .horizon-text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .horizon-section-heading > a { flex-shrink: 0; }
  .horizon-empty { padding: 40px; background: var(--surface); border-radius: 20px; }
  .horizon-empty a { text-decoration: underline; }
  .horizon-recent { margin-top: 44px; }
  .horizon-small-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 22px; }
  .horizon-small-heading h3 { font-size: 18px; font-weight: 550; letter-spacing: -.025em; }
  .horizon-small-heading > span { color: var(--faint); font-size: 12px; }
  .horizon-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .horizon-window { display: grid; grid-template-columns: 1fr 1.05fr; align-items: center; gap: clamp(28px, 6vw, 84px); margin-top: 100px; padding: 32px; padding-right: clamp(32px, 5vw, 72px); border: 1px solid var(--line); border-radius: 28px; background: var(--horizon-warm); }
  .horizon-window figure { margin: 0; overflow: hidden; border-radius: 18px; }
  .horizon-window img { display: block; width: 100%; height: auto; }
  .horizon-window h2 { margin: 23px 0; font-size: clamp(38px, 4.3vw, 58px); font-weight: 520; line-height: 1.04; letter-spacing: -.055em; }
  .horizon-window h2 em { font-family: var(--font-serif); color: var(--accent); font-weight: 400; }
  .horizon-window p { max-width: 470px; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .horizon-window .horizon-text-link { margin-top: 12px; }
  .horizon-topic-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .horizon-topic { position: relative; display: block; padding: 26px; border-radius: 20px; background: var(--horizon-blue); transition: transform 200ms ease; }
  .horizon-topic:hover { transform: translateY(-4px); }
  .horizon-topic.tone-1 { background: var(--horizon-green); }
  .horizon-topic.tone-2 { background: var(--horizon-warm); }
  .horizon-topic-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 11px; }
  .horizon-topic-symbol { font-size: 32px; line-height: 1; color: var(--accent); }
  .horizon-topic h3 { margin: 26px 0 10px; font-size: 23px; font-weight: 530; letter-spacing: -.04em; }
  .horizon-topic p { max-width: 240px; margin: 0 20px 12px 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
  .horizon-topic-arrow { position: absolute; right: 25px; bottom: 23px; color: var(--accent); }
  .horizon-follow { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-top: 80px; padding: 46px; border: 1px solid var(--line); border-radius: 24px; background: var(--horizon-green); }
  .horizon-follow h2 { margin: 16px 0 8px; font-size: clamp(26px, 3vw, 38px); font-weight: 520; line-height: 1.15; letter-spacing: -.045em; }
  .horizon-follow p { margin: 0; color: var(--muted); font-size: 14px; }
  .horizon-follow > a { flex-shrink: 0; }
  :global(:root[data-theme="dark"]) .horizon-hero::before { background: linear-gradient(180deg, #0f2d48c9, #123349b8 47%, #173b5040 74%, #173b5010); }
  :global(:root[data-theme="dark"]) .horizon-hero-copy { text-shadow: 0 1px 18px #133548aa; }
  :global(:root[data-theme="dark"]) .horizon-hero-copy h1,
  :global(:root[data-theme="dark"]) .horizon-hero-copy h1 em,
  :global(:root[data-theme="dark"]) .horizon-hero-copy > p { color: #fffdf4; }
  :global(:root[data-theme="dark"]) .horizon-kicker,
  :global(:root[data-theme="dark"]) .horizon-actions { text-shadow: none; }
  @media (min-width: 1700px) { .horizon-hero { min-height: 760px; } .horizon-hero-copy { padding-top: 68px; } }
  @media (max-width: 960px) {
    .horizon-hero { min-height: 650px; }
    .horizon-topic-ribbon { align-items: start; gap: 20px; }
    .horizon-topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .horizon-window { gap: 32px; padding: 24px; }
    .horizon-window h2 { font-size: 40px; }
  }
  @media (max-width: 680px) {
    .horizon-home { padding-top: 12px; }
    .horizon-hero { min-height: 650px; border-radius: 22px; }
    .horizon-landscape { object-position: 44% bottom; }
    .horizon-hero::before { background: linear-gradient(180deg, #e6f7f8f5 0%, #e6f7f8b0 40%, transparent 72%); }
    .horizon-hero-copy { padding: 38px 18px 200px; }
    .horizon-kicker { font-size: 9px; letter-spacing: .08em; padding: 6px 10px; }
    h1 { margin-top: 26px; font-size: clamp(42px, 10.8vw, 66px); letter-spacing: -.055em; }
    .horizon-hero-copy > p { font-size: 14px; }
    .desktop-break { display: none; }
    .horizon-actions { gap: 9px; margin-top: 23px; }
    .horizon-button { min-height: 44px; gap: 12px; padding: 11px 16px; font-size: 12px; }
    .horizon-field-note { right: 12px; bottom: 14px; left: 12px; justify-content: center; font-size: 9px; padding: 8px; }
    .horizon-topic-ribbon { display: block; padding-block: 20px; }
    .horizon-topic-ribbon > div { gap: 4px 16px; margin-top: 8px; }
    .horizon-topic-ribbon a { min-height: 40px; }
    .horizon-journal, .horizon-topics { padding-top: 54px; }
    .horizon-section-heading { align-items: start; flex-direction: column; gap: 10px; margin-bottom: 24px; }
    .horizon-small-heading { align-items: start; flex-direction: column; gap: 0; }
    .horizon-small-heading h3 { margin-bottom: 7px; }
    .horizon-small-heading > span { margin-bottom: 8px; }
    .horizon-card-grid { grid-template-columns: 1fr; gap: 24px; }
    .horizon-window { grid-template-columns: 1fr; margin-top: 60px; gap: 24px; padding: 18px; }
    .horizon-window > div { padding: 6px 8px 12px; }
    .horizon-window h2 { font-size: 42px; }
    .horizon-window p { font-size: 14px; }
    .horizon-topic-grid { grid-template-columns: 1fr; gap: 14px; }
    .horizon-topic { padding: 24px; }
    .horizon-topic h3 { margin-top: 20px; }
    .horizon-topic p { max-width: none; }
    .horizon-follow { flex-direction: column; align-items: start; margin-top: 54px; padding: 28px; gap: 22px; }
  }
</style>
