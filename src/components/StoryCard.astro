---
import type { DailySignal } from "../lib/daily";
import { categoryLabels, evidenceLabels } from "../lib/daily";
import type { LibraryImage } from "../lib/images";

interface Props {
  story: DailySignal;
  editionDate: string;
  image: LibraryImage;
  featured?: boolean;
}

const { story, editionDate, image, featured = false } = Astro.props;
const position = String(story.position).padStart(2, "0");
---

<article class:list={["story-card", { featured, community: story.origin === "community" }]}>
  <a class="card-link" href={`/daily/${editionDate}#${story.id}`} aria-label={story.headline}></a>

  <div class="card-top">
    <span class="signal-no">{position}</span>
    <div class="card-tags">
      <span class="tag">{categoryLabels[story.category] ?? story.category}</span>
      {story.region !== "global" && <span class="tag">{story.region.toUpperCase()}</span>}
      {story.openSource && <span class="tag open">OPEN</span>}
    </div>
  </div>

  <figure class:list={["card-image", `variant-${image.variant}`]}>
    <img
      src={image.src}
      srcset={image.srcset}
      sizes={featured ? "(max-width: 960px) 100vw, 52vw" : "(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"}
      width={image.width}
      height={image.height}
      alt={image.alt}
      loading={featured ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={featured ? "high" : "auto"}
    />
  </figure>

  <div class="card-content">
    <p class="source">{story.source.name} · {evidenceLabels[story.source.evidenceLabel]}</p>
    <h3>{story.headline}</h3>
    <p class="summary">{story.brief}</p>
  </div>

  <div class="card-footer">
    <span>{story.origin === "community" ? "COMMUNITY SIGNAL" : "SOURCE SIGNAL"}</span>
    <span aria-hidden="true">↗</span>
  </div>
</article>

<style>
  .story-card {
    position: relative;
    display: flex;
    min-height: 430px;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .story-card:hover {
    z-index: 2;
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-5px);
  }

  .card-link {
    position: absolute;
    z-index: 3;
    inset: 0;
  }

  .card-top,
  .card-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-top {
    padding: 18px 20px;
  }

  .signal-no {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    font-weight: 690;
  }

  .card-tags {
    display: flex;
    gap: 6px;
  }

  .tag.open {
    border-color: color-mix(in srgb, var(--signal) 55%, var(--line));
    background: color-mix(in srgb, var(--signal) 20%, transparent);
    color: var(--ink);
  }

  .card-image {
    height: 130px;
    margin: 0 20px 26px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(.2,.7,.2,1);
  }

  .story-card:hover .card-image img {
    transform: scale(1.025);
  }

  .card-content {
    padding: 0 20px 22px;
  }

  .source {
    margin: 0 0 10px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 620;
    letter-spacing: 0.04em;
  }

  h3 {
    margin: 0;
    font-size: clamp(21px, 2vw, 28px);
    font-weight: 570;
    letter-spacing: -0.035em;
    line-height: 1.18;
  }

  .summary {
    display: -webkit-box;
    margin: 14px 0 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .card-footer {
    margin-top: auto;
    padding: 13px 20px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 9px;
    font-weight: 720;
    letter-spacing: 0.13em;
  }

  .community {
    background: var(--community);
  }

  .featured {
    min-height: 560px;
    background: var(--ink);
    color: var(--bg);
  }

  .featured .tag,
  .featured .source,
  .featured .summary,
  .featured .card-footer {
    color: color-mix(in srgb, var(--bg) 66%, transparent);
  }

  .featured .tag,
  .featured .card-image,
  .featured .card-footer {
    border-color: color-mix(in srgb, var(--bg) 18%, transparent);
  }

  .featured .card-image {
    height: 210px;
  }

  .featured h3 {
    font-size: clamp(30px, 4vw, 48px);
  }

  @media (max-width: 720px) {
    .story-card,
    .featured {
      min-height: 410px;
    }

    .featured .card-image {
      height: 150px;
    }
  }
</style>
