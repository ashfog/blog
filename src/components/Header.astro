---
import SiteMark from "./SiteMark.astro";
import { colorModeStorageKey, directionForLanguage, siteConfig } from "../config/site";
import { getThemeManifest } from "../themes/registry";

const currentPath = Astro.url.pathname;
const links = siteConfig.navigation;
const activeTheme = getThemeManifest(siteConfig.theme.id);
const lightThemeColor = activeTheme.themeColors.light;
const darkThemeColor = activeTheme.themeColors.dark;
---

<header class="site-header" lang={siteConfig.site.language} dir={directionForLanguage(siteConfig.site.language)}>
  <div class="page-shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.site.name} home`}>
      <SiteMark />
      <span>{siteConfig.site.shortName}</span>
      {siteConfig.site.headerLabel && <em>{siteConfig.site.headerLabel}</em>}
    </a>

    <nav aria-label="Primary navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href))
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="search-link" href="/search" aria-label="Search">
        <span aria-hidden="true">⌕</span>
        <span>Search</span>
      </a>
      {siteConfig.theme.allowColorModeToggle && (
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
          <span class="sun" aria-hidden="true">◐</span>
          <span class="moon" aria-hidden="true">◑</span>
        </button>
      )}
    </div>
  </div>
</header>

<script is:inline define:vars={{ colorModeStorageKey, lightThemeColor, darkThemeColor }}>
  const root = document.documentElement;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem(colorModeStorageKey, next);
    } catch {}
    document.querySelector("#site-theme-color")?.setAttribute("content", next === "dark" ? darkThemeColor : lightThemeColor);
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(18px);
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .site-header {
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    backdrop-filter: blur(12px);
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .header-inner {
    min-height: 84px;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .brand {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .brand em {
    color: var(--accent);
    font-family: var(--font-sans);
    letter-spacing: .12em;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) nav a {
    font-size: 12px;
    font-weight: 520;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) nav a[aria-current="page"]::after {
    bottom: -32px;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .search-link,
  :global(:root[data-site-theme="ashfog-humanist"]) .theme-toggle {
    border-radius: 8px;
    background: transparent;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 70px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 10px;
    font-size: 16px;
    font-weight: 780;
    letter-spacing: 0.08em;
  }

  .brand em {
    margin-left: 2px;
    color: var(--faint);
    font-size: 9px;
    font-style: normal;
    font-weight: 620;
    letter-spacing: 0.14em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  nav a {
    position: relative;
    color: var(--muted);
    font-size: 13px;
    font-weight: 580;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -25px;
    left: 0;
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 10px;
  }

  .search-link,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
  }

  .search-link {
    gap: 6px;
    padding: 0 13px;
    font-size: 12px;
  }

  .theme-toggle {
    width: 36px;
    padding: 0;
    cursor: pointer;
  }

  .moon,
  :global(:root[data-theme="dark"]) .sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .moon {
    display: block;
  }

  @media (max-width: 840px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: auto;
      padding-top: 12px;
    }

    .header-actions {
      grid-row: 1;
      grid-column: 2;
    }

    nav {
      grid-row: 2;
      grid-column: 1 / -1;
      width: 100%;
      gap: 24px;
      margin-top: 10px;
      padding: 10px 0 11px;
      overflow-x: auto;
      border-top: 1px solid var(--line);
    }

    nav a[aria-current="page"]::after {
      bottom: -11px;
    }

    :global(:root[data-site-theme="ashfog-humanist"]) .header-inner {
      min-height: auto;
    }

    :global(:root[data-site-theme="ashfog-humanist"]) nav a[aria-current="page"]::after {
      bottom: -11px;
    }
  }

  @media (max-width: 540px) {
    .brand em,
    .search-link span:last-child {
      display: none;
    }

    .search-link {
      width: 36px;
      padding: 0;
      font-size: 18px;
    }
  }
</style>
