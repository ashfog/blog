---
import SiteMark from "./SiteMark.astro";
import { directionForLanguage, siteConfig } from "../config/site";

const socialLinks = [
  { label: "GitHub", href: siteConfig.social.github },
  { label: "X", href: siteConfig.social.x },
  { label: "YouTube", href: siteConfig.social.youtube }
].filter((link) => link.href);
---

<footer lang={siteConfig.site.language} dir={directionForLanguage(siteConfig.site.language)}>
  <div class="page-shell footer-grid">
    <div class="footer-brand">
      <a href="/"><SiteMark compact /> <strong>{siteConfig.site.shortName}</strong></a>
      <p>{siteConfig.site.tagline}<br />{siteConfig.site.description}</p>
    </div>

    <div>
      <span>Read</span>
      <a href="/articles">Latest Articles</a>
      <a href="/topics">Browse Topics</a>
      <a href="/search">Search</a>
    </div>

    <div>
      <span>Follow</span>
      <a href="/rss.xml">RSS Feed</a>
      <a href="/about">About {siteConfig.site.shortName}</a>
      {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
  <div class="page-shell footer-bottom">
    <div class="footer-identity">
      <span>© {new Date().getFullYear()} {siteConfig.site.shortName}</span>
      {siteConfig.publisher.showEmail && siteConfig.publisher.email && (
        <a
          class="footer-email"
          href={`mailto:${siteConfig.publisher.email}`}
          aria-label={`Email ${siteConfig.publisher.displayName} at ${siteConfig.publisher.email}`}
        >{siteConfig.publisher.email}</a>
      )}
    </div>
    <span>{siteConfig.site.description}</span>
  </div>
</footer>

<style>
  footer {
    margin-top: 88px;
    padding: 60px 0 32px;
    border-top: 1px solid var(--line-strong);
    background: var(--surface);
  }

  :global(:root[data-site-theme="ashfog-humanist"]) footer {
    margin-top: 110px;
    padding-top: 76px;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .footer-brand a {
    font-family: var(--font-serif);
    font-size: 22px;
    letter-spacing: -.02em;
  }

  :global(:root[data-site-theme="ashfog-humanist"]) .footer-brand p {
    max-width: 520px;
    font-size: clamp(22px, 2.8vw, 36px);
    line-height: 1.25;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
  }

  .footer-grid > div:not(.footer-brand) {
    display: flex;
    align-items: start;
    flex-direction: column;
    gap: 9px;
  }

  .footer-brand a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    letter-spacing: 0.08em;
  }

  .footer-brand p {
    margin: 18px 0 0;
    color: var(--muted);
    font-family: var(--font-serif);
  }

  .footer-grid span {
    margin-bottom: 6px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 680;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-grid a {
    color: var(--muted);
    font-size: 13px;
  }

  .footer-grid a:hover {
    color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 11px;
  }

  .footer-identity {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    color: var(--faint);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition: color 180ms ease, text-decoration-color 180ms ease;
  }

  .footer-email::before {
    margin: 0 10px;
    color: var(--line-strong);
    content: "·";
    text-decoration: none;
  }

  .footer-email:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .footer-email:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 720px) {
    footer {
      margin-top: 80px;
      padding-bottom: 28px;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
