---
import BrandMark from "./BrandMark.astro";
---

<footer>
  <div class="page-shell footer-grid">
    <div class="footer-brand">
      <a href="/"><BrandMark compact /> <strong>ASHFOG</strong></a>
      <p>Not everything worth seeing is visible.<br />穿过噪音，看见真正重要的信号。</p>
    </div>

    <div>
      <span>阅读</span>
      <a href="/">今日日报</a>
      <a href="/daily">历史归档</a>
      <a href="/topics">主题索引</a>
    </div>

    <div>
      <span>订阅</span>
      <a href="/rss.xml">RSS Feed</a>
      <a href="/about">编辑原则</a>
      <a href="https://github.com/ashfog/blog">GitHub</a>
    </div>
  </div>
  <div class="page-shell footer-bottom">
    <span>© {new Date().getFullYear()} ASHFOG</span>
    <span>Daily intelligence · Asia/Shanghai</span>
  </div>
</footer>

<style>
  footer {
    margin-top: 120px;
    padding: 60px 0 32px;
    border-top: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 60px;
  }

  .footer-grid > div:not(.footer-brand) {
    display: flex;
    align-items: start;
    flex-direction: column;
    gap: 9px;
  }

  .footer-brand a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    letter-spacing: 0.08em;
  }

  .footer-brand p {
    margin: 18px 0 0;
    color: var(--muted);
    font-family: var(--font-serif);
  }

  .footer-grid span {
    margin-bottom: 6px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 680;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-grid a {
    color: var(--muted);
    font-size: 13px;
  }

  .footer-grid a:hover {
    color: var(--ink);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 11px;
  }

  @media (max-width: 720px) {
    footer {
      margin-top: 80px;
      padding-bottom: 100px;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
