---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const clipId = `ashfog-mark-${compact ? "compact" : "regular"}`;
---

<span class:list={["brand-mark", { compact }]} aria-hidden="true">
  <svg viewBox="0 0 64 64" focusable="false">
    <circle class="field" cx="32" cy="32" r="24" />
    <defs>
      <clipPath id={clipId}>
        <circle cx="32" cy="32" r="24" />
      </clipPath>
    </defs>
    <g clip-path={`url(#${clipId})`} transform="rotate(-12 32 32)">
      <rect class="signal" x="15.8" y="5" width="4.2" height="54" transform="rotate(-8 17.9 32)" />
      <rect class="signal" x="22.9" y="5" width="4.2" height="54" transform="rotate(-4 25 32)" />
      <rect class="signal" x="29.9" y="5" width="4.2" height="54" />
      <rect class="signal" x="36.9" y="5" width="4.2" height="54" transform="rotate(4 39 32)" />
      <rect class="signal" x="44" y="5" width="4.2" height="54" transform="rotate(8 46.1 32)" />
    </g>
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-flex;
    width: 27px;
    height: 27px;
    flex: 0 0 auto;
  }

  .brand-mark.compact {
    width: 22px;
    height: 22px;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .field {
    fill: var(--ink);
  }

  .signal {
    fill: var(--bg);
  }
</style>
