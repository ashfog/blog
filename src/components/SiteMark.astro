---
import { siteConfig } from "../config/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<span class:list={["site-mark", { compact }]} aria-hidden="true">
  <img class="mark-light" src={siteConfig.branding.mark} alt="" width="64" height="64" />
  <img class="mark-dark" src={siteConfig.branding.markDark} alt="" width="64" height="64" />
</span>

<style>
  .site-mark {
    display: inline-grid;
    width: 27px;
    height: 27px;
    flex: 0 0 auto;
    place-items: center;
  }

  .site-mark.compact {
    width: 22px;
    height: 22px;
  }

  img {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
  }

  .mark-dark,
  :global(:root[data-theme="dark"]) .mark-light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .mark-dark {
    display: block;
  }
</style>
