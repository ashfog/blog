---
import PageArtwork from "../components/PageArtwork.astro";
import { getPageImage } from "../lib/images";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
const pageImage = getPageImage("search");
---

<BaseLayout
  title="Search"
  description={`Search ${siteConfig.site.name} articles, topics, and source material.`}
  image={pageImage?.largeSrc}
  noindex
  breadcrumbs={[
    { name: siteConfig.site.name, path: "/" },
    { name: "Search", path: "/search" }
  ]}
>
  <section class="search-page page-shell">
    <header>
      <span class="eyebrow">Search the library</span>
      <h1>Search {siteConfig.site.shortName}</h1>
      <p>Find articles by project, website, person, tool, topic, source, or keyword.</p>
    </header>
    {pageImage && <PageArtwork image={pageImage} />}
    <div id="search" class="search-box">
      <p class="loading">Loading the search index…</p>
    </div>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  const mount = document.querySelector("#search");
  if (window.PagefindUI && mount) {
    mount.innerHTML = "";
    new window.PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      excerptLength: 22,
      translations: {
        placeholder: "Search VPS, open source, websites, films…",
        zero_results: "No articles found for [SEARCH_TERM]",
        clear_search: "Clear",
        load_more: "Load more",
        search_label: "Search this site",
        filters_label: "Filters",
        many_results: "[COUNT] results",
        one_result: "1 result"
      }
    });
  } else if (mount) {
    mount.innerHTML = '<p class="loading">Search becomes available after the production index is built.</p>';
  }
</script>

<style>
  .search-page {
    min-height: 700px;
    padding-top: 76px;
  }

  header {
    padding-bottom: 60px;
    border-bottom: 1px solid var(--line-strong);
  }

  h1 {
    margin: 28px 0 15px;
    font-size: clamp(50px, 6vw, 74px);
    font-weight: 510;
    letter-spacing: -.07em;
    line-height: 1;
  }

  header p,
  .loading {
    color: var(--muted);
  }

  .search-box {
    max-width: 900px;
    padding: 60px 0;
  }

  :global(.pagefind-ui__search-input) {
    height: 64px !important;
    border: 1px solid var(--line-strong) !important;
    border-radius: 999px !important;
    background: var(--surface) !important;
    color: var(--ink) !important;
    font-family: var(--font-sans) !important;
    font-size: 16px !important;
  }

  :global(.pagefind-ui__result) {
    border-color: var(--line) !important;
  }
</style>
