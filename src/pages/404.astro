---
import PageArtwork from "../components/PageArtwork.astro";
import { getPageImage } from "../lib/images";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageImage = getPageImage("404");
---

<BaseLayout image={pageImage?.largeSrc} title="页面未找到" noindex>
  <section class="not-found page-shell">
    <span>404 / SIGNAL LOST</span>
    <h1>这条信号消失在雾里。</h1>
    <p>页面可能已移动，或者这个地址从未存在。</p>
    {pageImage && <PageArtwork image={pageImage} compact />}
    <a href="/">返回今日 ASHFOG →</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 720px;
    align-items: start;
    flex-direction: column;
    justify-content: center;
  }

  span {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: .14em;
  }

  h1 {
    max-width: 900px;
    margin: 28px 0 18px;
    font-size: clamp(54px, 9vw, 112px);
    font-weight: 510;
    letter-spacing: -.07em;
    line-height: .92;
  }

  p {
    color: var(--muted);
  }

  a {
    margin-top: 28px;
    font-weight: 650;
  }
</style>
