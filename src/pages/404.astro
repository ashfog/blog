---
import PageArtwork from "../components/PageArtwork.astro";
import { getPageImage } from "../lib/images";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageImage = getPageImage("404");
---

<BaseLayout image={pageImage?.largeSrc} title="Page Not Found" noindex>
  <section class="not-found page-shell">
    <span>404 / SIGNAL LOST</span>
    <h1>This Signal Disappeared Into the Fog</h1>
    <p>The page may have moved, or this address may never have existed.</p>
    {pageImage && <PageArtwork image={pageImage} compact />}
    <a href="/">Return to today’s ASHFOG →</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 620px;
    align-items: start;
    flex-direction: column;
    justify-content: center;
  }

  span {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: .14em;
  }

  h1 {
    max-width: 900px;
    margin: 28px 0 18px;
    font-size: clamp(48px, 6vw, 76px);
    font-weight: 510;
    letter-spacing: -.07em;
    line-height: 1;
  }

  p {
    color: var(--muted);
  }

  a {
    margin-top: 28px;
    font-weight: 650;
  }
</style>
