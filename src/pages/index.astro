---
import ArticleCard from "../components/ArticleCard.astro";
import HumanistArticleCard from "../components/HumanistArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  categoryLabels,
  formatArticleDate,
  getActiveArticleCategories,
  getArticleSlug,
  getArticles
} from "../lib/articles";
import { getPageImage } from "../lib/images";
import { siteConfig } from "../config/site";

const articles = await getArticles();
const latest = articles[0];
const remaining = articles.slice(1);
const focusAreas = getActiveArticleCategories(articles, 6);
const railArticles = articles.slice(0, 8);
const pageImage = getPageImage("home");
const isHumanist = siteConfig.theme.id === "ashfog-humanist";
---

<BaseLayout
  title={`${siteConfig.site.name} — Independent Articles`}
  description={siteConfig.site.description}
  image={pageImage?.largeSrc}
>
  {isHumanist ? (
    <>
      <section class="humanist-hero page-shell">
        <div class="humanist-intro">
          <span class="eyebrow">Independent publishing</span>
          <h1>Ideas, tools and signals worth keeping.</h1>
          <p>{siteConfig.site.description}</p>
          <a class="humanist-button" href="/articles">Browse all articles</a>
        </div>
        <nav class="humanist-focus" aria-label="Featured topics">
          {focusAreas.slice(0, 4).map((area) => (
            <a href={`/topics/${area.slug}`}>
              <span>{area.label}</span>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </nav>
      </section>

      {railArticles.length > 1 && (
        <section class="humanist-latest" aria-label="Recent articles">
          <div
            class="latest-viewport page-shell"
            data-latest-marquee
            role="region"
            aria-label="Continuously scrolling recent articles"
          >
            <div class="latest-track">
              <div class="latest-group">
                {railArticles.map((article) => (
                  <a href={`/articles/${getArticleSlug(article)}`}>
                    <span>{categoryLabels[article.data.category] ?? article.data.category}</span>
                    <strong>{article.data.title}</strong>
                    <time datetime={article.data.publishedAt.toISOString()}>{formatArticleDate(article.data.publishedAt)}</time>
                  </a>
                ))}
              </div>
              <div class="latest-group" aria-hidden="true">
                {railArticles.map((article) => (
                  <a href={`/articles/${getArticleSlug(article)}`} tabindex="-1">
                    <span>{categoryLabels[article.data.category] ?? article.data.category}</span>
                    <strong>{article.data.title}</strong>
                    <time datetime={article.data.publishedAt.toISOString()}>{formatArticleDate(article.data.publishedAt)}</time>
                  </a>
                ))}
              </div>
            </div>
            <button
              class="latest-motion-toggle"
              type="button"
              data-latest-toggle
              aria-label="Pause recent articles animation"
              aria-pressed="false"
            >
              <span aria-hidden="true" data-latest-toggle-icon>Ⅱ</span>
            </button>
          </div>
        </section>
      )}

      <script>
        document.querySelectorAll<HTMLElement>("[data-latest-marquee]").forEach((marquee) => {
          const toggle = marquee.querySelector<HTMLButtonElement>("[data-latest-toggle]");
          const icon = marquee.querySelector<HTMLElement>("[data-latest-toggle-icon]");
          if (!toggle || !icon) return;

          toggle.addEventListener("click", () => {
            const paused = marquee.dataset.paused !== "true";
            marquee.dataset.paused = String(paused);
            toggle.setAttribute("aria-pressed", String(paused));
            toggle.setAttribute("aria-label", paused
              ? "Resume recent articles animation"
              : "Pause recent articles animation");
            icon.textContent = paused ? "▶" : "Ⅱ";
          });

          marquee.addEventListener("focusin", (event) => {
            if ((event.target as Element).closest(".latest-group a")) {
              marquee.dataset.focusPaused = "true";
            }
          });
          marquee.addEventListener("focusout", () => {
            window.requestAnimationFrame(() => {
              const focusedLink = document.activeElement?.closest?.(".latest-group a");
              marquee.dataset.focusPaused = String(Boolean(focusedLink && marquee.contains(focusedLink)));
            });
          });
        });
      </script>

      <section class="humanist-library page-shell">
        <div class="library-heading">
          <div>
            <span class="eyebrow">The library</span>
            <h2>Recent writing</h2>
          </div>
          <div class="library-actions">
            <a href="/search">Search</a>
            <a href="/articles">View all</a>
          </div>
        </div>
        {articles.length > 0 ? (
          <div class="humanist-grid">
            {articles.slice(0, 9).map((article, index) => <HumanistArticleCard article={article} priority={index < 3} />)}
          </div>
        ) : (
          <div class="humanist-empty"><h2>The first focused article is being prepared.</h2></div>
        )}
      </section>
    </>
  ) : (
    <>
      <section class="home-hero page-shell">
        <div class="hero-label">
          <span class="eyebrow">Independent field notes</span>
          <span>TECHNOLOGY / CULTURE / CURIOSITY</span>
        </div>
        <div class="hero-copy">
          <h1>Look closer at the things<br />shaping <em>what comes next</em></h1>
          <p>{siteConfig.site.name} publishes {siteConfig.site.description.charAt(0).toLocaleLowerCase(siteConfig.site.locale) + siteConfig.site.description.slice(1)} No daily quota. No feed-shaped filler.</p>
        </div>
      </section>

      {latest ? (
        <section class="latest page-shell">
          <div class="section-heading">
            <h2>Latest article</h2>
            <p>The newest article by publication time—never a manually pinned repeat.</p>
          </div>
          <ArticleCard article={latest} featured />
        </section>
      ) : (
        <section class="empty page-shell">
          <span class="eyebrow">New publication</span>
          <h2>The first focused article is being prepared.</h2>
        </section>
      )}

      {remaining.length > 0 && (
        <section class="more page-shell">
          <div class="section-heading">
            <h2>More from {siteConfig.site.shortName}</h2>
            <a class="text-link" href="/articles">Browse the archive</a>
          </div>
          <div class="article-grid">
            {remaining.slice(0, 8).map((article) => <ArticleCard article={article} grid />)}
          </div>
        </section>
      )}

      {focusAreas.length > 0 && (
        <section class="topic-strip page-shell">
          <div class="section-heading">
            <div><span class="eyebrow">Areas of focus</span><h2>What the library is actually covering</h2></div>
            <p>These areas are generated from the current articles and ordered by depth of coverage.</p>
          </div>
          <div class="focus-grid">
            {focusAreas.map((area) => (
              <a href={`/topics/${area.slug}`}>
                <span class="focus-name">{area.label}</span><span class="focus-meta">{area.count} {area.count === 1 ? "article" : "articles"}</span><b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>

<style>
  .humanist-hero { display: grid; grid-template-columns: minmax(260px, .68fr) minmax(0, 1.32fr); gap: clamp(60px, 10vw, 170px); min-height: 540px; align-items: center; padding-block: clamp(74px, 10vw, 150px); }
  .humanist-intro h1 { max-width: 460px; margin: 26px 0 22px; font-size: clamp(34px, 4vw, 58px); font-weight: 520; letter-spacing: -.055em; line-height: 1; }
  .humanist-intro p { max-width: 430px; margin: 0 0 30px; color: var(--muted); line-height: 1.7; }
  .humanist-button { display: inline-flex; min-height: 44px; align-items: center; padding: 0 20px; border-radius: 8px; background: var(--ink); color: var(--bg); font-size: 13px; font-weight: 650; }
  .humanist-focus { display: grid; }
  .humanist-focus a { display: flex; align-items: baseline; justify-content: space-between; gap: 28px; padding: 7px 0; font-family: var(--font-serif); font-size: clamp(43px, 5.7vw, 82px); font-weight: 500; letter-spacing: -.05em; line-height: .94; }
  .humanist-focus b { color: var(--faint); font-family: var(--font-sans); font-size: .44em; font-weight: 400; transition: color 180ms ease, transform 180ms ease; }
  .humanist-focus a:hover b { color: var(--accent); transform: translate(4px, -4px); }
  .humanist-latest { overflow: hidden; border-block: 1px solid var(--line-strong); }
  .latest-viewport { position: relative; overflow: hidden; }
  .latest-track { display: flex; width: max-content; animation: latest-marquee 96s linear infinite; will-change: transform; }
  .latest-group { display: flex; flex: none; }
  .latest-group a { display: grid; width: clamp(280px, 26vw, 390px); min-width: 0; gap: 12px; padding: 28px 26px; border-right: 1px solid var(--line); }
  .latest-group a:first-child { border-left: 1px solid var(--line); }
  .latest-track span, .latest-track time { color: var(--faint); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .latest-track strong { overflow: hidden; font-family: var(--font-serif); font-size: 18px; font-weight: 500; line-height: 1.08; text-overflow: ellipsis; }
  .latest-viewport:hover .latest-track,
  .latest-viewport[data-paused="true"] .latest-track,
  .latest-viewport[data-focus-paused="true"] .latest-track { animation-play-state: paused; }
  .latest-motion-toggle { position: absolute; z-index: 2; right: 12px; bottom: 12px; display: grid; width: 34px; height: 34px; place-items: center; padding: 0; border: 1px solid var(--line-strong); border-radius: 50%; background: color-mix(in srgb, var(--bg) 90%, transparent); color: var(--muted); font: 600 11px/1 var(--font-sans); backdrop-filter: blur(10px); cursor: pointer; }
  .latest-motion-toggle:hover, .latest-motion-toggle:focus-visible { border-color: var(--accent); color: var(--ink); }
  @keyframes latest-marquee { to { transform: translate3d(-50%, 0, 0); } }
  .humanist-library { padding-block: clamp(90px, 11vw, 160px); }
  .library-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 48px; }
  .library-heading h2 { margin: 12px 0 0; font-family: var(--font-serif); font-size: clamp(48px, 7vw, 92px); font-weight: 500; letter-spacing: -.055em; line-height: .92; }
  .library-actions { display: flex; gap: 10px; }
  .library-actions a { padding: 10px 15px; border: 1px solid var(--line-strong); border-radius: 8px; color: var(--muted); font-size: 12px; }
  .library-actions a:hover { border-color: var(--accent); color: var(--ink); }
  .humanist-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 30px; }
  .humanist-empty { min-height: 360px; padding-top: 60px; border-top: 1px solid var(--line-strong); }
  .humanist-empty h2 { max-width: 760px; font-family: var(--font-serif); font-size: clamp(42px, 6vw, 70px); font-weight: 500; }

  .home-hero { padding-top: clamp(54px, 7vw, 96px); }
  .hero-label { display: flex; align-items: center; justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid var(--line-strong); color: var(--faint); font-size: 10px; font-weight: 680; letter-spacing: .12em; }
  .hero-copy { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .45fr); gap: clamp(42px, 7vw, 110px); align-items: end; padding: clamp(48px, 7vw, 100px) 0 clamp(76px, 9vw, 130px); }
  .hero-copy h1 { max-width: 1200px; margin: 0; font-size: clamp(54px, 7.5vw, 118px); font-weight: 510; letter-spacing: -.07em; line-height: .91; text-wrap: balance; }
  .hero-copy h1 em { color: var(--accent); font-family: var(--font-serif); font-weight: 430; }
  .hero-copy p { max-width: 420px; margin: 0; color: var(--muted); font-size: 16px; line-height: 1.75; }
  .latest, .more { padding-bottom: clamp(78px, 9vw, 130px); }
  .article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .topic-strip { padding: 64px 0 20px; border-top: 1px solid var(--line-strong); }
  .topic-strip .section-heading { align-items: end; }
  .topic-strip h2 { max-width: 720px; margin: 14px 0 0; font-size: clamp(34px, 4.5vw, 58px); font-weight: 520; letter-spacing: -.055em; line-height: 1; }
  .topic-strip .section-heading > p { max-width: 400px; color: var(--muted); line-height: 1.65; }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 34px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .focus-grid a { position: relative; display: flex; min-height: 132px; flex-direction: column; justify-content: space-between; gap: 26px; padding: 25px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .focus-grid a:hover { background: var(--surface); }
  .focus-name { padding-right: 28px; font-size: clamp(22px, 2.5vw, 34px); letter-spacing: -.04em; }
  .focus-meta { color: var(--faint); font-size: 10px; font-weight: 680; letter-spacing: .09em; text-transform: uppercase; }
  .focus-grid b { position: absolute; top: 26px; right: 24px; color: var(--accent); font-size: 16px; }
  .empty { min-height: 420px; padding-top: 80px; border-top: 1px solid var(--line-strong); }
  .empty h2 { max-width: 780px; font-size: clamp(42px, 6vw, 74px); letter-spacing: -.06em; }

  @media (max-width: 980px) {
    .humanist-hero { grid-template-columns: 1fr; min-height: 0; gap: 54px; }
    .humanist-intro h1, .humanist-intro p { max-width: 680px; }
    .latest-group a { width: clamp(260px, 78vw, 360px); }
    .humanist-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-copy { grid-template-columns: 1fr; }
    .hero-copy p { max-width: 680px; }
    .article-grid { grid-template-columns: 1fr; }
    .focus-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .humanist-focus a { font-size: clamp(42px, 12vw, 58px); }
    .library-heading { align-items: start; flex-direction: column; }
    .humanist-grid { grid-template-columns: 1fr; }
    .hero-label { align-items: start; flex-direction: column; gap: 10px; }
    .hero-copy h1 { font-size: clamp(48px, 14vw, 64px); }
    .focus-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .latest-viewport { overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: thin; }
    .latest-track { animation: none; will-change: auto; }
    .latest-group[aria-hidden="true"], .latest-motion-toggle { display: none; }
  }
</style>
