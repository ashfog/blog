---
import BaseLayout from "../layouts/BaseLayout.astro";
import StoryCard from "../components/StoryCard.astro";
import {
  categoryLabels,
  formatDate,
  getLatestEdition,
  readingMinutes
} from "../lib/daily";
import {
  getEditionHeroImage,
  getEditionStoryImages,
  getPageImage
} from "../lib/images";

const edition = getLatestEdition();
const storyImages = getEditionStoryImages(edition);
const homeImage = getPageImage("home");
const analysisImage = getPageImage("analysis");
const seoImage = getEditionHeroImage(edition, storyImages);
const featured = edition.stories.find((story) => story.highlight) ?? edition.stories[0];
const news = edition.stories.filter((story) => story.kind === "news" && story.id !== featured.id);
const community = edition.stories.filter((story) => story.kind === "community");
const newsCount = edition.stories.filter((story) => story.kind === "news").length;
const categories = [...new Set(edition.stories.map((story) => story.category))];
const sourceCount = new Set(edition.stories.map((story) => story.source.id)).size;
---

<BaseLayout title="ASHFOG — Daily AI Intelligence" description={edition.description} image={seoImage?.largeSrc ?? homeImage?.largeSrc}>
  <section class="hero page-shell">
    <div class="hero-copy">
      <span class="eyebrow">Daily intelligence · {edition.editionDate}</span>
      <h1>Cut Through the Noise<br /><em>See What Matters Today</em></h1>
      <p>{edition.description}</p>
      <div class="hero-actions">
        <a class="primary" href={`/daily/${edition.editionDate}`}>Read the full edition <span>↗</span></a>
        <a class="secondary" href="#signals">Explore today’s signals ↓</a>
      </div>
    </div>

    <aside class="hero-meta">
      {homeImage && (
        <img
          class="hero-meta-art"
          src={homeImage.src}
          srcset={homeImage.srcset}
          sizes="(max-width: 960px) 100vw, 32vw"
          width={homeImage.width}
          height={homeImage.height}
          alt={homeImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}
      <div class="status">
        <span class="pulse"></span>
        <div>
          <strong>Today’s edition is live</strong>
          <small>{formatDate(edition.editionDate)} · {readingMinutes(edition)} min read</small>
        </div>
      </div>
      <dl>
        <div><dt>{newsCount}</dt><dd> verified news stories</dd></div>
        <div><dt>{sourceCount}</dt><dd> independent sources</dd></div>
        <div><dt>{edition.stories.filter((story) => story.openSource).length}</dt><dd> open-source updates</dd></div>
        <div><dt>{edition.stories.filter((story) => story.kind === "community").length}</dt><dd> community findings</dd></div>
      </dl>
      <div class="topic-row">
        {categories.slice(0, 6).map((category) => (
          <a class="tag" href={`/topics/${category}`}>{categoryLabels[category] ?? category}</a>
        ))}
      </div>
    </aside>
  </section>

  <section class="lead page-shell">
    <StoryCard
      story={featured}
      editionDate={edition.editionDate}
      image={storyImages.get(featured.id)!}
      featured
    />
    <div class="analysis-panel">
      <span class="eyebrow">Editor’s synthesis</span>
      <p class="issue">ISSUE / {edition.editionDate.replaceAll("-", "")}</p>
      <h2>{edition.dailyAnalysis.title}</h2>
      <p>{edition.dailyAnalysis.body}</p>
      {analysisImage && (
        <img
          class="analysis-art"
          src={analysisImage.src}
          srcset={analysisImage.srcset}
          sizes="(max-width: 960px) 100vw, 48vw"
          width={analysisImage.width}
          height={analysisImage.height}
          alt={analysisImage.alt}
          loading="lazy"
          decoding="async"
        />
      )}
      <a class="text-link" href={`/daily/${edition.editionDate}#analysis`}>Read the full synthesis</a>
      <div class="analysis-line" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
  </section>

  <section class="signals page-shell" id="signals">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Verified signals</span>
        <span class="section-count">{newsCount} news stories · {community.length} community reports</span>
        <h2>What Actually Changed Today</h2>
      </div>
      <p>Every fact returns to its source<br />Every judgment keeps its evidence boundary</p>
    </div>
    <div class="signal-grid">
      {news.map((story) => (
        <StoryCard
          story={story}
          editionDate={edition.editionDate}
          image={storyImages.get(story.id)!}
        />
      ))}
    </div>
  </section>

  <section class="community-section">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Community layer</span>
          <h2>Beyond Official Narratives,<br />What Is the Community Testing?</h2>
        </div>
        <p>Popularity is not evidence<br />Only signals that can change adoption decisions</p>
      </div>
      <div class="community-grid">
        {community.map((story) => (
          <StoryCard
            story={story}
            editionDate={edition.editionDate}
            image={storyImages.get(story.id)!}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="archive-cta page-shell">
    <p class="issue">ASHFOG ARCHIVE / DAILY</p>
    <h2>One Page a Day.<br />Build Your Own Industry Timeline.</h2>
    <a class="primary" href="/daily">Open the daily archive <span>→</span></a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: 650px;
    grid-template-columns: 1.5fr 0.7fr;
    gap: 80px;
    align-items: end;
    padding-top: 90px;
    padding-bottom: 70px;
  }

  .hero-copy h1 {
    margin: 24px 0 26px;
    font-size: clamp(62px, 9.2vw, 126px);
    font-weight: 510;
    letter-spacing: -0.075em;
    line-height: 0.87;
  }

  .hero-copy h1 em {
    color: var(--accent);
    font-family: var(--font-serif);
    font-weight: 430;
  }

  .hero-copy > p {
    max-width: 620px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(16px, 1.8vw, 21px);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 38px;
  }

  .primary,
  .secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 650;
  }

  .primary {
    padding: 0 22px;
    background: var(--ink);
    color: var(--bg);
  }

  .primary:hover span {
    transform: translateX(3px);
  }

  .primary span {
    transition: transform 180ms ease;
  }

  .secondary {
    color: var(--muted);
  }

  .hero-meta {
    padding: 24px 0 6px 28px;
    border-left: 1px solid var(--line-strong);
  }

  .hero-meta-art {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 26px;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .status div {
    display: flex;
    flex-direction: column;
  }

  .status strong {
    font-size: 13px;
  }

  .status small {
    color: var(--faint);
    font-size: 11px;
  }

  .pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--signal) 18%, transparent);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 32px 0 26px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  dl div {
    display: flex;
    min-height: 92px;
    flex-direction: column;
    justify-content: center;
    padding: 12px 16px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  dt {
    font-size: 26px;
    font-weight: 550;
    letter-spacing: -0.04em;
  }

  dd {
    margin: 0;
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .lead {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 16px;
    padding: 40px 0 110px;
  }

  .analysis-panel {
    position: relative;
    min-height: 560px;
    overflow: hidden;
    padding: clamp(30px, 5vw, 64px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-raised);
  }

  .issue {
    margin: 26px 0 80px;
    color: var(--faint);
    font-size: 10px;
    font-weight: 680;
    letter-spacing: 0.14em;
  }

  .analysis-panel h2 {
    max-width: 540px;
    margin: 0 0 24px;
    font-family: var(--font-serif);
    font-size: clamp(32px, 4.3vw, 56px);
    font-weight: 460;
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .analysis-panel > p:not(.issue) {
    display: -webkit-box;
    max-width: 610px;
    overflow: hidden;
    color: var(--muted);
    font-size: 14px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
  }

  .analysis-art {
    position: absolute;
    right: 38px;
    bottom: 30px;
    width: min(42%, 300px);
    height: auto;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    opacity: .32;
    object-fit: cover;
    filter: saturate(.72);
    mask-image: linear-gradient(135deg, transparent 0, black 25%);
  }

  .analysis-panel .text-link {
    position: absolute;
    bottom: 42px;
    left: clamp(30px, 5vw, 64px);
    font-size: 13px;
  }

  .analysis-line {
    position: absolute;
    right: 38px;
    bottom: 32px;
    display: flex;
    align-items: end;
    gap: 4px;
  }

  .analysis-line i {
    width: 3px;
    background: var(--accent);
  }

  .analysis-line i:nth-child(1) { height: 18px; }
  .analysis-line i:nth-child(2) { height: 35px; }
  .analysis-line i:nth-child(3) { height: 58px; }

  .signals {
    padding-bottom: 120px;
  }

  .signal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .community-section {
    padding: 100px 0;
    background: var(--community);
    border-block: 1px solid var(--line);
  }

  .community-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .archive-cta {
    display: flex;
    min-height: 540px;
    align-items: start;
    flex-direction: column;
    justify-content: center;
  }

  .archive-cta .issue {
    margin: 0 0 25px;
  }

  .archive-cta h2 {
    margin: 0 0 38px;
    font-size: clamp(44px, 7vw, 88px);
    font-weight: 510;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .hero-meta {
      padding: 24px 0 0;
      border-top: 1px solid var(--line-strong);
      border-left: 0;
    }

    .lead {
      grid-template-columns: 1fr;
    }

    .analysis-art {
      opacity: .22;
    }

    .signal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-top: 70px;
    }

    .hero-copy h1 {
      font-size: clamp(58px, 20vw, 92px);
    }

    .hero-actions {
      align-items: start;
      flex-direction: column;
    }

    .signal-grid,
    .community-grid {
      grid-template-columns: 1fr;
    }

    .analysis-panel {
      min-height: 590px;
    }
  }
</style>
