---
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getArticles, categoryLabels } from "../lib/articles";
import { getPageImage } from "../lib/images";

const articles = await getArticles();
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const remaining = articles.filter((article) => article.id !== featured?.id);
const pageImage = getPageImage("home");
---

<BaseLayout
  title="ASHFOG — Independent AI Articles"
  description="Focused, source-linked articles about AI models, agents, open source, developer tools, infrastructure, and research."
  image={pageImage?.largeSrc}
>
  <section class="home-hero page-shell">
    <div class="hero-label">
      <span class="eyebrow">Independent AI field notes</span>
      <span>MODELS / SYSTEMS / PEOPLE</span>
    </div>
    <div class="hero-copy">
      <h1>Understand the systems<br />shaping <em>what comes next</em></h1>
      <p>ASHFOG publishes focused articles on AI models, agents, open source, infrastructure, and the ideas connecting them. No daily quota. No feed-shaped filler.</p>
    </div>
  </section>

  {featured ? (
    <section class="latest page-shell">
      <div class="section-heading">
        <h2>Latest article</h2>
        <p>One subject, examined with context and original sources.</p>
      </div>
      <ArticleCard article={featured} featured />
    </section>
  ) : (
    <section class="empty page-shell">
      <span class="eyebrow">New publication</span>
      <h2>The first focused article is being prepared.</h2>
    </section>
  )}

  {remaining.length > 0 && (
    <section class="more page-shell">
      <div class="section-heading">
        <h2>More from ASHFOG</h2>
        <a class="text-link" href="/articles">View all articles</a>
      </div>
      <div class="article-grid">
        {remaining.slice(0, 4).map((article) => <ArticleCard article={article} />)}
      </div>
    </section>
  )}

  <section class="topic-strip page-shell">
    <span class="eyebrow">Areas of focus</span>
    <div>
      {Object.entries(categoryLabels).map(([slug, label]) => (
        <a href={`/topics/${slug}`}>{label}<span>↗</span></a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { padding-top: clamp(54px, 7vw, 96px); }
  .hero-label { display: flex; align-items: center; justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid var(--line-strong); color: var(--faint); font-size: 10px; font-weight: 680; letter-spacing: .12em; }
  .hero-copy { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, .45fr); gap: clamp(42px, 7vw, 110px); align-items: end; padding: clamp(48px, 7vw, 100px) 0 clamp(76px, 9vw, 130px); }
  h1 { max-width: 1200px; margin: 0; font-size: clamp(54px, 7.5vw, 118px); font-weight: 510; letter-spacing: -.07em; line-height: .91; text-wrap: balance; }
  h1 em { color: var(--accent); font-family: var(--font-serif); font-weight: 430; }
  .hero-copy p { max-width: 420px; margin: 0; color: var(--muted); font-size: 16px; line-height: 1.75; }
  .latest, .more { padding-bottom: clamp(78px, 9vw, 130px); }
  .article-grid { display: grid; gap: 24px; }
  .topic-strip { padding: 64px 0 20px; border-top: 1px solid var(--line-strong); }
  .topic-strip > div { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 30px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .topic-strip a { display: flex; min-height: 100px; align-items: center; justify-content: space-between; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: clamp(20px, 2.2vw, 30px); letter-spacing: -.035em; }
  .topic-strip a:hover { background: var(--surface); }
  .topic-strip a span { color: var(--accent); font-size: 16px; }
  .empty { min-height: 420px; padding-top: 80px; border-top: 1px solid var(--line-strong); }
  .empty h2 { max-width: 780px; font-size: clamp(42px, 6vw, 74px); letter-spacing: -.06em; }
  @media (max-width: 860px) {
    .hero-copy { grid-template-columns: 1fr; }
    .hero-copy p { max-width: 680px; }
    .topic-strip > div { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .hero-label { align-items: start; flex-direction: column; gap: 10px; }
    h1 { font-size: clamp(48px, 14vw, 64px); }
    .topic-strip > div { grid-template-columns: 1fr; }
  }
</style>
