---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabels, formatDate, getLatestEdition, readingMinutes } from "../lib/daily";
import { getEditionHeroImage } from "../lib/images";

const edition = getLatestEdition();
const seoImage = getEditionHeroImage(edition);
const communityVoiceCount = edition.signals.reduce(
  (total, signal) => total + signal.communityVoices.length + (signal.origin === "community" ? 1 : 0),
  0
);
const sourceCount = new Set(edition.signals.flatMap((signal) => [
  signal.source.id,
  ...signal.communityVoices.map((voice) => voice.source.id)
])).size;
const categories = [...new Set(edition.signals.map((signal) => signal.category))];
---

<BaseLayout title="ASHFOG — Daily AI Intelligence" description={edition.description} image={seoImage?.largeSrc}>
  <section class="today page-shell">
    <div class="today-bar">
      <span class="eyebrow">Today&rsquo;s connected brief</span>
      <span>ISSUE / {edition.editionDate.replaceAll("-", "")}</span>
    </div>

    <div class="today-grid">
      <div class="today-copy">
        <p class="brand-line">Cut through the noise. See what matters today.</p>
        <h1>{edition.article.synthesis.title}</h1>
        <p class="dek">{edition.description}</p>

        <div class="today-meta" aria-label="Edition details">
          <span>{formatDate(edition.editionDate)}</span>
          <span>{readingMinutes(edition)} min read</span>
          <span>{sourceCount} linked sources</span>
          {communityVoiceCount > 0 && <span>{communityVoiceCount} community voices</span>}
        </div>

        <div class="topic-row">
          {categories.slice(0, 5).map((category) => (
            <a class="tag" href={`/topics/${category}`}>{categoryLabels[category] ?? category}</a>
          ))}
        </div>

        <a class="primary" href={`/daily/${edition.editionDate}`}>
          Read today&rsquo;s edition <span aria-hidden="true">→</span>
        </a>
      </div>

      {seoImage && (
        <a class="today-art" href={`/daily/${edition.editionDate}`} aria-label="Open today&rsquo;s edition">
          <img
            src={seoImage.src}
            srcset={seoImage.srcset}
            sizes="(max-width: 820px) 100vw, 48vw"
            width={seoImage.width}
            height={seoImage.height}
            alt={seoImage.alt}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </a>
      )}
    </div>
  </section>

  <section class="archive-strip page-shell">
    <div>
      <span class="eyebrow">Daily archive</span>
      <h2>One page a day, one clear industry timeline.</h2>
    </div>
    <a class="archive-link" href="/daily">Browse previous editions <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .today {
    padding-top: clamp(54px, 7vw, 92px);
  }

  .today-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--line-strong);
    color: var(--faint);
    font-size: 10px;
    font-weight: 680;
    letter-spacing: .12em;
  }

  .today-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, .88fr);
    gap: clamp(48px, 7vw, 96px);
    align-items: center;
    padding: clamp(46px, 6vw, 76px) 0 88px;
  }

  .brand-line {
    margin: 0 0 24px;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
  }

  h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(52px, 6.4vw, 82px);
    font-weight: 520;
    letter-spacing: -.062em;
    line-height: .98;
    text-wrap: balance;
  }

  .dek {
    max-width: 650px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.65;
  }

  .today-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 28px;
    color: var(--faint);
    font-size: 11px;
  }

  .today-meta span + span::before {
    margin-right: 22px;
    color: var(--line-strong);
    content: "·";
  }

  .topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 24px;
  }

  .primary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 26px;
    margin-top: 34px;
    padding: 0 23px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 13px;
    font-weight: 680;
  }

  .today-art {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    aspect-ratio: 4 / 5;
  }

  .today-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 320ms ease;
  }

  .today-art:hover img {
    transform: scale(1.015);
  }

  .archive-strip {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    padding: 58px 0 30px;
    border-top: 1px solid var(--line-strong);
  }

  .archive-strip h2 {
    max-width: 670px;
    margin: 16px 0 0;
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 520;
    letter-spacing: -.045em;
    line-height: 1.08;
  }

  .archive-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 18px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line-strong);
    font-size: 13px;
    font-weight: 650;
  }

  @media (max-width: 820px) {
    .today-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .today-art {
      aspect-ratio: 3 / 2;
    }
  }

  @media (max-width: 640px) {
    .today {
      padding-top: 42px;
    }

    .today-bar {
      align-items: start;
      flex-direction: column;
      gap: 8px;
    }

    .today-grid {
      padding: 34px 0 64px;
    }

    h1 {
      font-size: clamp(46px, 13vw, 56px);
      line-height: 1;
    }

    .today-meta span + span::before {
      display: none;
    }

    .archive-strip {
      align-items: start;
      flex-direction: column;
      padding-bottom: 0;
    }
  }
</style>
