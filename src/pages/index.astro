---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categoryLabels, formatDate, getLatestEdition, getSignalMap, readingMinutes } from "../lib/daily";
import { getEditionHeroImage, getEditionStoryImages, getPageImage } from "../lib/images";

const edition = getLatestEdition();
const signalMap = getSignalMap(edition);
const signalImages = getEditionStoryImages(edition);
const homeImage = getPageImage("home");
const seoImage = getEditionHeroImage(edition, signalImages);
const communityVoiceCount = edition.signals.reduce(
  (total, signal) => total + signal.communityVoices.length + (signal.origin === "community" ? 1 : 0),
  0
);
const sourceCount = new Set(edition.signals.flatMap((signal) => [
  signal.source.id,
  ...signal.communityVoices.map((voice) => voice.source.id)
])).size;
const categories = [...new Set(edition.signals.map((signal) => signal.category))];
const themes = edition.article.sections.map((section) => {
  const signals = section.signalIds.flatMap((id) => {
    const signal = signalMap.get(id);
    return signal ? [signal] : [];
  });
  return { ...section, signals, image: signals[0] ? signalImages.get(signals[0].id) : undefined };
});
---

<BaseLayout title="ASHFOG — Daily AI Intelligence" description={edition.description} image={seoImage?.largeSrc ?? homeImage?.largeSrc}>
  <section class="hero page-shell">
    <div class="hero-copy">
      <span class="eyebrow">Daily intelligence · {edition.editionDate}</span>
      <h1>Cut Through the Noise<br /><em>See What Matters Today</em></h1>
      <p>{edition.description}</p>
      <div class="hero-actions">
        <a class="primary" href={`/daily/${edition.editionDate}`}>Read today&rsquo;s edition <span>→</span></a>
        <a class="secondary" href="#themes">See today&rsquo;s themes</a>
      </div>
    </div>

    <aside class="hero-meta">
      {homeImage && (
        <img
          class="hero-meta-art"
          src={homeImage.src}
          srcset={homeImage.srcset}
          sizes="(max-width: 960px) 100vw, 32vw"
          width={homeImage.width}
          height={homeImage.height}
          alt={homeImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      )}
      <div class="status">
        <span class="pulse"></span>
        <div>
          <strong>Today&rsquo;s edition is live</strong>
          <small>{formatDate(edition.editionDate)} · {readingMinutes(edition)} min read</small>
        </div>
      </div>
      <dl>
        <div><dt>{edition.signals.length}</dt><dd>source signals</dd></div>
        <div><dt>{sourceCount}</dt><dd>linked sources</dd></div>
        <div><dt>{themes.length}</dt><dd>connected themes</dd></div>
        <div><dt>{communityVoiceCount}</dt><dd>community voices</dd></div>
      </dl>
      <div class="topic-row">
        {categories.slice(0, 6).map((category) => (
          <a class="tag" href={`/topics/${category}`}>{categoryLabels[category] ?? category}</a>
        ))}
      </div>
    </aside>
  </section>

  <section class="lead page-shell">
    <div class="lead-copy">
      <span class="eyebrow">Editor&rsquo;s synthesis</span>
      <p class="issue">ISSUE / {edition.editionDate.replaceAll("-", "")}</p>
      <h2>{edition.article.synthesis.title}</h2>
      <p>{edition.article.synthesis.body}</p>
      <a class="text-link" href={`/daily/${edition.editionDate}#synthesis`}>Continue reading →</a>
    </div>
    {seoImage && (
      <img
        class="lead-art"
        src={seoImage.src}
        srcset={seoImage.srcset}
        sizes="(max-width: 960px) 100vw, 48vw"
        width={seoImage.width}
        height={seoImage.height}
        alt={seoImage.alt}
        loading="lazy"
        decoding="async"
      />
    )}
  </section>

  <section class="themes page-shell" id="themes">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Inside today&rsquo;s edition</span>
        <h2>One Article<br />A Connected View</h2>
      </div>
      <p>{edition.signals.length} deduplicated events grouped into {themes.length} themes<br />Community observations appear beside the events they illuminate</p>
    </div>

    <div class="theme-list">
      {themes.map((theme) => (
        <a class="theme" href={`/daily/${edition.editionDate}#${theme.id}`}>
          <span class="theme-number">{String(theme.position).padStart(2, "0")}</span>
          <div class="theme-copy">
            <span class="eyebrow">{theme.kicker}</span>
            <h3>{theme.title}</h3>
            <p>{theme.signals.length} linked source {theme.signals.length === 1 ? "signal" : "signals"}</p>
          </div>
          {theme.image && (
            <img
              src={theme.image.src}
              srcset={theme.image.srcset}
              sizes="(max-width: 720px) 34vw, 220px"
              width={theme.image.width}
              height={theme.image.height}
              alt={theme.image.alt}
              loading="lazy"
              decoding="async"
            />
          )}
          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="archive-cta page-shell">
    <p class="issue">ASHFOG ARCHIVE / DAILY</p>
    <h2>One Page a Day<br />Build Your Own Industry Timeline</h2>
    <a class="primary" href="/daily">Open the daily archive <span>→</span></a>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; min-height: 650px; grid-template-columns: 1.5fr .7fr; gap: 80px; align-items: end; padding-top: 90px; padding-bottom: 70px; }
  .hero-copy h1 { margin: 24px 0 26px; font-size: clamp(62px, 9.2vw, 126px); font-weight: 510; letter-spacing: -.075em; line-height: .87; }
  .hero-copy h1 em { color: var(--accent); font-family: var(--font-serif); font-weight: 430; }
  .hero-copy > p { max-width: 620px; margin: 0; color: var(--muted); font-size: clamp(16px, 1.8vw, 21px); line-height: 1.65; }
  .hero-actions { display: flex; align-items: center; gap: 22px; margin-top: 38px; }
  .primary, .secondary { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; gap: 18px; border-radius: 999px; font-size: 13px; font-weight: 650; }
  .primary { padding: 0 22px; background: var(--ink); color: var(--bg); }
  .secondary { color: var(--muted); }
  .hero-meta { padding: 24px 0 6px 28px; border-left: 1px solid var(--line-strong); }
  .hero-meta-art { display: block; width: 100%; height: auto; margin: 0 0 26px; aspect-ratio: 3 / 2; border: 1px solid var(--line); object-fit: cover; }
  .status { display: flex; align-items: center; gap: 13px; }
  .status div { display: flex; flex-direction: column; }
  .status strong { font-size: 13px; }
  .status small { color: var(--faint); font-size: 11px; }
  .pulse { width: 9px; height: 9px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 0 5px color-mix(in srgb, var(--signal) 18%, transparent); }
  dl { display: grid; grid-template-columns: 1fr 1fr; margin: 32px 0 26px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  dl div { display: flex; min-height: 92px; flex-direction: column; justify-content: center; padding: 12px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  dt { font-size: 26px; font-weight: 550; letter-spacing: -.04em; }
  dd { margin: 0; color: var(--faint); font-size: 10px; letter-spacing: .08em; }
  .topic-row { display: flex; flex-wrap: wrap; gap: 7px; }
  .lead { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 40px 0 120px; }
  .lead-copy { padding: clamp(34px, 5vw, 68px); border: 1px solid var(--line); border-radius: 8px; background: var(--surface-raised); }
  .issue { margin: 24px 0 62px; color: var(--faint); font-size: 10px; font-weight: 680; letter-spacing: .14em; }
  .lead h2 { margin: 0 0 26px; font-family: var(--font-serif); font-size: clamp(38px, 5vw, 64px); font-weight: 450; letter-spacing: -.045em; line-height: 1.05; }
  .lead-copy > p:not(.issue) { display: -webkit-box; overflow: hidden; color: var(--muted); line-height: 1.75; -webkit-box-orient: vertical; -webkit-line-clamp: 8; }
  .text-link { display: inline-block; margin-top: 22px; font-size: 13px; }
  .lead-art { width: 100%; height: 100%; min-height: 560px; border: 1px solid var(--line); border-radius: 8px; object-fit: cover; }
  .themes { padding-bottom: 120px; }
  .theme-list { border-top: 1px solid var(--line-strong); }
  .theme { position: relative; display: grid; grid-template-columns: 80px minmax(0, 1fr) 220px 24px; gap: 28px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .theme:hover h3 { color: var(--accent); }
  .theme-number { color: var(--accent); font-size: 18px; }
  .theme h3 { margin: 10px 0 8px; font-size: clamp(26px, 3.5vw, 46px); font-weight: 520; letter-spacing: -.045em; transition: color 180ms ease; }
  .theme p { margin: 0; color: var(--faint); font-size: 11px; }
  .theme img { width: 220px; height: 130px; border: 1px solid var(--line); object-fit: cover; }
  .arrow { color: var(--accent); }
  .archive-cta { display: flex; min-height: 540px; align-items: start; flex-direction: column; justify-content: center; }
  .archive-cta .issue { margin: 0 0 25px; }
  .archive-cta h2 { margin: 0 0 38px; font-size: clamp(44px, 7vw, 88px); font-weight: 510; letter-spacing: -.06em; line-height: .98; }
  @media (max-width: 960px) {
    .hero, .lead { grid-template-columns: 1fr; gap: 40px; }
    .hero-meta { padding: 24px 0 0; border-top: 1px solid var(--line-strong); border-left: 0; }
    .theme { grid-template-columns: 50px 1fr 160px 20px; }
    .theme img { width: 160px; height: 100px; }
  }
  @media (max-width: 640px) {
    .hero { min-height: auto; padding-top: 70px; }
    .hero-copy h1 { font-size: clamp(58px, 20vw, 92px); }
    .hero-actions { align-items: start; flex-direction: column; }
    .theme { grid-template-columns: 34px 1fr 96px; gap: 14px; }
    .theme img { width: 96px; height: 76px; }
    .theme .arrow { display: none; }
    .lead-art { min-height: 320px; }
  }
</style>
