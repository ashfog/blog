---
import PageArtwork from "../components/PageArtwork.astro";
import { getPageImage } from "../lib/images";
import BaseLayout from "../layouts/BaseLayout.astro";
const pageImage = getPageImage("about");
---

<BaseLayout
  title="About ASHFOG"
  description="ASHFOG’s editorial principles, evidence standards, and automated publishing method."
  image={pageImage?.largeSrc}
  pageType="AboutPage"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "About", path: "/about" }
  ]}
>
  <section class="about page-shell">
    <header>
      <span class="eyebrow">About ASHFOG</span>
      <h1>Not More News<br /><em>Less Noise</em></h1>
      <p>ASHFOG tracks material changes across AI, open source, developer tools, infrastructure, research, and policy. Every fact returns to a source, and every judgment keeps its evidence boundary visible.</p>
    </header>
    {pageImage && <PageArtwork image={pageImage} priority />}

    <div class="principles">
      <article>
        <span>01</span>
        <h2>Sources First</h2>
        <p>Official announcements, releases, papers, policy texts, and maintainer statements come first. Media and communities help discovery; they do not replace primary evidence.</p>
      </article>
      <article>
        <span>02</span>
        <h2>Quality Before Quota</h2>
        <p>There is no routine story quota. Quiet days stay concise, while busy days expand only when additional events meet the same materiality and evidence standards.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Community Evidence Is Labeled</h2>
        <p>Single tests, multiple-user reports, and maintainer confirmations are labeled separately. Popularity, votes, and reposts are never presented as proof.</p>
      </article>
      <article>
        <span>04</span>
        <h2>Machine Validated</h2>
        <p>Before publication, validation checks strict JSON, language, word counts, dates, duplicate events, source identity, links, balance, and the previous seven editions.</p>
      </article>
    </div>

    <section class="manifesto">
      <p>“Not everything worth seeing is visible.”</p>
      <h2>Fog is not an obstacle.<br />It is a reminder:<br /><strong>what matters must be recognized.</strong></h2>
    </section>
  </section>
</BaseLayout>

<style>
  .about {
    padding-top: 130px;
  }

  header {
    display: grid;
    min-height: 610px;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
    align-items: end;
    padding-bottom: 80px;
  }

  .eyebrow {
    grid-column: 1 / -1;
    align-self: start;
  }

  h1 {
    margin: 0;
    font-size: clamp(62px, 9vw, 120px);
    font-weight: 510;
    letter-spacing: -0.075em;
    line-height: .88;
  }

  h1 em {
    color: var(--accent);
    font-family: var(--font-serif);
    font-weight: 430;
  }

  header p {
    margin: 0;
    color: var(--muted);
    font-size: 17px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .principles article {
    min-height: 340px;
    padding: 26px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  article span {
    color: var(--accent);
    font-size: 11px;
  }

  article h2 {
    margin: 120px 0 14px;
    font-size: 26px;
    font-weight: 540;
    letter-spacing: -.04em;
  }

  article p {
    color: var(--muted);
    font-size: 13px;
  }

  .manifesto {
    min-height: 700px;
    padding-top: 140px;
  }

  .manifesto > p {
    color: var(--faint);
    font-family: var(--font-serif);
  }

  .manifesto h2 {
    margin: 35px 0;
    font-family: var(--font-serif);
    font-size: clamp(42px, 6.5vw, 86px);
    font-weight: 430;
    letter-spacing: -.05em;
    line-height: 1.08;
  }

  .manifesto strong {
    color: var(--accent);
    font-weight: inherit;
  }

  @media (max-width: 800px) {
    header {
      grid-template-columns: 1fr;
    }

    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>
