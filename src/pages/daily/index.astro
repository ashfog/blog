---
import PageArtwork from "../../components/PageArtwork.astro";
import { getPageImage } from "../../lib/images";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getEditions, readingMinutes } from "../../lib/daily";

const editions = getEditions();
const pageImage = getPageImage("archive");
---

<BaseLayout
  title="Daily Archive"
  description="The ASHFOG archive of source-linked global daily intelligence."
  image={pageImage?.largeSrc}
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "Daily Archive", path: "/daily" }
  ]}
>
  <section class="archive page-shell">
    <header>
      <span class="eyebrow">Daily archive</span>
      <h1>One Page a Day<br /><em>See Change Take Shape</em></h1>
      <p>Review one connected article per day across AI, open source, and the developer ecosystem. Every edition preserves its underlying source signals and community voices.</p>
    </header>
    {pageImage && <PageArtwork image={pageImage} priority />}

    <div class="archive-list">
      {editions.map((edition, index) => (
        <a href={`/daily/${edition.editionDate}`}>
          <span class="index">{String(index + 1).padStart(2, "0")}</span>
          <span class="date">{formatDate(edition.editionDate, { year: undefined })}</span>
          <strong>{edition.title}</strong>
          <span class="meta">{edition.signals.length} signals · {readingMinutes(edition)} min</span>
          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .archive {
    padding-top: 76px;
  }

  header {
    display: grid;
    min-height: 310px;
    grid-template-columns: 1.5fr .7fr;
    align-items: end;
    gap: 50px;
    padding-bottom: 54px;
  }

  .eyebrow {
    grid-column: 1 / -1;
    align-self: start;
  }

  h1 {
    margin: 0;
    font-size: clamp(46px, 6.5vw, 78px);
    font-weight: 510;
    letter-spacing: -0.07em;
    line-height: .96;
  }

  h1 em {
    color: var(--accent);
    font-family: var(--font-serif);
    font-weight: 430;
  }

  header p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .archive-list {
    border-top: 1px solid var(--line-strong);
  }

  .archive-list a {
    display: grid;
    grid-template-columns: 60px 130px 1fr auto 30px;
    gap: 24px;
    align-items: center;
    padding: 24px 10px;
    border-bottom: 1px solid var(--line);
    transition: background 180ms ease, padding 180ms ease;
  }

  .archive-list a:hover {
    padding-inline: 20px;
    background: var(--surface);
  }

  .index,
  .date,
  .meta {
    color: var(--faint);
    font-size: 11px;
  }

  .archive-list strong {
    font-size: clamp(20px, 2.5vw, 32px);
    font-weight: 540;
    letter-spacing: -0.035em;
  }

  .arrow {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .archive {
      padding-top: 80px;
    }

    header {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 24px;
    }

    .archive-list a {
      grid-template-columns: 35px 1fr 24px;
      gap: 10px;
    }

    .date,
    .meta {
      display: none;
    }
  }
</style>
