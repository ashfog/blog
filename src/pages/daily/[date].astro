---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categoryLabels,
  evidenceLabels,
  formatDate,
  getEditions,
  getSignalMap,
  readingMinutes,
  type DailyEdition
} from "../../lib/daily";
import { getEditionHeroImage } from "../../lib/images";

export function getStaticPaths() {
  return getEditions().map((edition) => ({
    params: { date: edition.editionDate },
    props: { edition }
  }));
}

interface Props {
  edition: DailyEdition;
}

const { edition } = Astro.props;
const signalMap = getSignalMap(edition);
const heroImage = getEditionHeroImage(edition);
const synthesisParagraphs = edition.article.synthesis.body.split(/\n\s*\n/u).filter(Boolean);
const sections = edition.article.sections.map((section) => {
  const signals = section.signalIds.flatMap((id) => {
    const signal = signalMap.get(id);
    return signal ? [signal] : [];
  });
  return {
    ...section,
    paragraphs: section.body.split(/\n\s*\n/u).filter(Boolean),
    signals,
    communityVoices: signals.flatMap((signal) =>
      signal.communityVoices.map((voice) => ({ signal, voice }))
    )
  };
});
const otherSignals = edition.article.otherSignalIds.flatMap((id) => {
  const signal = signalMap.get(id);
  return signal ? [signal] : [];
});
const communityVoiceCount = edition.signals.reduce(
  (total, signal) => total + signal.communityVoices.length + (signal.origin === "community" ? 1 : 0),
  0
);
const articleTags = [
  ...new Set(edition.signals.flatMap((signal) => [
    categoryLabels[signal.category] ?? signal.category,
    ...signal.topics
  ]))
];
const citations = [
  ...new Set(edition.signals.flatMap((signal) => [
    signal.source.url,
    ...signal.communityVoices.map((voice) => voice.source.url)
  ]))
];
---

<BaseLayout
  title={edition.title}
  description={edition.description}
  image={heroImage?.largeSrc}
  type="article"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "Daily Archive", path: "/daily" },
    { name: edition.editionDate, path: `/daily/${edition.editionDate}` }
  ]}
  article={{
    publishedTime: edition.generatedAt,
    modifiedTime: edition.generatedAt,
    section: "AI and developer intelligence",
    tags: articleTags,
    citations
  }}
>
  <article class="edition page-shell" data-pagefind-body>
    <header class="edition-header">
      <div class="edition-kicker">
        <span class="eyebrow">ASHFOG Daily</span>
        <span>ISSUE / {edition.editionDate.replaceAll("-", "")}</span>
      </div>
      <h1>{edition.title}</h1>
      <p>{edition.description}</p>
      <div class="edition-meta">
        <span>{formatDate(edition.editionDate)}</span>
        <span>{readingMinutes(edition)} min read</span>
        <span>{edition.signals.length} source signals</span>
        <span>{citations.length} source links</span>
        <span>1 editorial image</span>
        {communityVoiceCount > 0 && <span>{communityVoiceCount} community voices</span>}
      </div>
    </header>

    {heroImage && (
      <figure class="edition-cover">
        <img
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 1400px) 100vw, 1320px"
          width={heroImage.width}
          height={heroImage.height}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <aside class="edition-nav" aria-label="Edition contents">
      <span>CONTENTS</span>
      <a href="#synthesis">Synthesis</a>
      {sections.map((section) => <a href={`#${section.id}`}>{String(section.position).padStart(2, "0")}</a>)}
      {otherSignals.length > 0 && <a href="#other-signals">Other signals</a>}
      <a href="#method">Method</a>
    </aside>

    <section class="synthesis" id="synthesis" data-pagefind-meta="section:synthesis">
      <div class="synthesis-label">
        <span class="section-number">00</span>
        <span class="eyebrow">Editor&rsquo;s synthesis</span>
      </div>
      <div class="synthesis-grid">
        <h2>{edition.article.synthesis.title}</h2>
        <div class="synthesis-copy">
          {synthesisParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <div class="article-sections">
      {sections.map((section) => (
        <section class="article-section" id={section.id} data-pagefind-meta={`section:${section.kicker}`}>
          <header class="section-header">
            <span class="section-number">{String(section.position).padStart(2, "0")}</span>
            <div>
              <span class="eyebrow">{section.kicker}</span>
              <h2>{section.title}</h2>
            </div>
          </header>

          <div class="section-content">
            <div class="prose">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <aside class="source-trail" aria-label={`Sources for ${section.title}`}>
              <span class="eyebrow">Source trail</span>
              {section.signals.map((signal) => (
                <a id={signal.id} href={signal.source.url} target="_blank" rel="noopener noreferrer">
                  <span>{String(signal.position).padStart(2, "0")}</span>
                  <strong>{signal.headline}</strong>
                  <small>{signal.source.name} ↗</small>
                </a>
              ))}
            </aside>
          </div>

          {section.communityVoices.length > 0 && (
            <aside class="community-pulse">
              <div class="community-heading">
                <span class="eyebrow">Community pulse</span>
                <strong>What people are testing and noticing</strong>
              </div>
              <div class="community-list">
                {section.communityVoices.map(({ voice }) => (
                  <div>
                    <p>{voice.summary}</p>
                    <a href={voice.source.url} target="_blank" rel="noopener noreferrer">
                      {voice.source.name} · {evidenceLabels[voice.source.evidenceLabel]} ↗
                    </a>
                  </div>
                ))}
              </div>
            </aside>
          )}
        </section>
      ))}
    </div>

    {otherSignals.length > 0 && (
      <section class="other-signals" id="other-signals">
        <header>
          <span class="eyebrow">Other signals</span>
          <h2>The rest of today&rsquo;s field notes</h2>
        </header>
        <div class="other-list">
          {otherSignals.map((signal) => (
            <article id={signal.id}>
              <span>{String(signal.position).padStart(2, "0")}</span>
              <div>
                <h3>{signal.headline}</h3>
                <p>{signal.brief}</p>
                <a href={signal.source.url} target="_blank" rel="noopener noreferrer">
                  {signal.source.name} · {evidenceLabels[signal.source.evidenceLabel]} ↗
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="method" id="method">
      <span class="eyebrow">Method & evidence</span>
      <h2>How This Edition Is Made</h2>
      <div class="method-grid">
        <div><b>01</b><strong>Trailing 24-hour window</strong><p>Every configured source is checked for up to 15 entries before the 09:30 New York cutoff.</p></div>
        <div><b>02</b><strong>One event, one signal</strong><p>Reports about the same underlying event are grouped by content, with the original source preferred.</p></div>
        <div><b>03</b><strong>One connected article</strong><p>Related signals become themes; community observations stay beside the event they help explain.</p></div>
        <div><b>04</b><strong>Source-linked throughout</strong><p>Every factual signal and community observation retains its collected source link.</p></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .edition { padding-top: 86px; }
  .edition-header { max-width: 970px; padding: 70px 0 90px; }
  .edition-kicker { display: flex; justify-content: space-between; color: var(--faint); font-size: 10px; font-weight: 680; letter-spacing: .12em; }
  .edition-header h1 { max-width: 920px; margin: 30px 0; font-size: clamp(52px, 8vw, 108px); font-weight: 510; letter-spacing: -.07em; line-height: .96; }
  .edition-header > p { max-width: 720px; margin: 0; color: var(--muted); font-size: clamp(17px, 2vw, 22px); line-height: 1.6; }
  .edition-meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 40px; color: var(--faint); font-size: 11px; }
  .edition-cover { height: clamp(300px, 52vw, 650px); margin: 0 0 46px; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
  .edition-cover img { width: 100%; height: 100%; object-fit: cover; }
  .edition-nav { position: sticky; z-index: 5; top: 86px; display: flex; align-items: center; gap: 24px; margin-bottom: 72px; padding: 13px 18px; overflow-x: auto; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface-raised) 92%, transparent); backdrop-filter: blur(16px); white-space: nowrap; }
  .edition-nav span, .edition-nav a { color: var(--faint); font-size: 10px; letter-spacing: .1em; }
  .synthesis { margin-bottom: 132px; padding: clamp(34px, 5vw, 72px); border: 1px solid var(--line); border-radius: 8px; background: var(--surface-raised); box-shadow: var(--shadow); scroll-margin-top: 150px; }
  .synthesis-label { display: flex; align-items: center; gap: 18px; }
  .section-number { color: var(--accent); font-size: 18px; font-weight: 650; letter-spacing: -.03em; }
  .synthesis-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr); gap: clamp(48px, 8vw, 110px); align-items: start; margin-top: 34px; }
  .synthesis h2 { margin: 0; font-family: var(--font-serif); font-size: clamp(40px, 5.4vw, 76px); font-weight: 450; letter-spacing: -.045em; line-height: 1.04; }
  .synthesis-copy p { margin: 0 0 1.25em; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .article-section { padding: 20px 0 130px; scroll-margin-top: 150px; }
  .section-header { display: grid; grid-template-columns: 1fr 3fr; gap: 40px; padding: 28px 0 54px; border-top: 1px solid var(--line-strong); }
  .section-header h2 { max-width: 900px; margin: 18px 0 0; font-size: clamp(42px, 6vw, 78px); font-weight: 520; letter-spacing: -.06em; line-height: 1; }
  .section-content { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(260px, .8fr); gap: clamp(50px, 8vw, 120px); max-width: 1050px; margin-left: auto; }
  .prose p { margin: 0 0 1.45em; color: var(--muted); font-family: var(--font-serif); font-size: clamp(20px, 2.1vw, 27px); line-height: 1.62; }
  .source-trail { border-top: 1px solid var(--line-strong); }
  .source-trail > .eyebrow { display: block; padding: 18px 0; }
  .source-trail a { display: grid; grid-template-columns: 28px 1fr; gap: 4px 10px; padding: 16px 0; border-top: 1px solid var(--line); }
  .source-trail a > span { grid-row: 1 / 3; color: var(--accent); font-size: 11px; }
  .source-trail strong { font-size: 12px; line-height: 1.4; }
  .source-trail small { color: var(--faint); font-size: 10px; }
  .community-pulse { display: grid; grid-template-columns: 1fr 2.4fr; gap: 50px; max-width: 1050px; margin: 68px 0 0 auto; padding: 34px; border-left: 3px solid var(--accent); background: var(--community); }
  .community-heading { display: flex; flex-direction: column; gap: 14px; }
  .community-heading strong { font-family: var(--font-serif); font-size: 22px; font-weight: 450; line-height: 1.25; }
  .community-list > div + div { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); }
  .community-list p { margin: 0 0 10px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .community-list a, .other-list a { color: var(--faint); font-size: 10px; }
  .other-signals { padding: 30px 0 120px; scroll-margin-top: 150px; }
  .other-signals header { display: grid; grid-template-columns: 1fr 3fr; gap: 40px; padding: 30px 0; border-block: 1px solid var(--line-strong); }
  .other-signals h2 { margin: 0; font-size: clamp(36px, 5vw, 62px); letter-spacing: -.05em; }
  .other-list article { display: grid; grid-template-columns: 1fr 3fr; gap: 40px; padding: 38px 0; border-bottom: 1px solid var(--line); }
  .other-list article > span { color: var(--accent); font-size: 18px; }
  .other-list h3 { margin: 0 0 12px; font-size: 26px; letter-spacing: -.03em; }
  .other-list p { max-width: 760px; color: var(--muted); line-height: 1.7; }
  .method { padding: 90px 0; border-top: 1px solid var(--line-strong); scroll-margin-top: 150px; }
  .method h2 { margin: 20px 0 55px; font-size: clamp(42px, 6vw, 76px); font-weight: 520; letter-spacing: -.06em; }
  .method-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .method-grid div { min-height: 230px; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .method-grid b { display: block; margin-bottom: 52px; color: var(--accent); }
  .method-grid strong { display: block; font-size: 15px; }
  .method-grid p { color: var(--faint); font-size: 12px; line-height: 1.65; }
  @media (max-width: 800px) {
    .synthesis-grid, .section-content, .community-pulse { grid-template-columns: 1fr; }
    .section-header, .other-signals header, .other-list article { grid-template-columns: 48px 1fr; gap: 20px; }
    .method-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .edition { padding-top: 62px; }
    .edition-header { padding-bottom: 62px; }
    .synthesis { margin-bottom: 90px; }
    .method-grid { grid-template-columns: 1fr; }
  }
</style>
