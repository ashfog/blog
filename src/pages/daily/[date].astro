---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categoryLabels,
  evidenceLabels,
  formatDate,
  getEditions,
  getSignalMap,
  readingMinutes,
  type DailyEdition
} from "../../lib/daily";
import { getEditionHeroImage } from "../../lib/images";

export function getStaticPaths() {
  return getEditions().map((edition) => ({
    params: { date: edition.editionDate },
    props: { edition }
  }));
}

interface Props {
  edition: DailyEdition;
}

const { edition } = Astro.props;
const signalMap = getSignalMap(edition);
const heroImage = getEditionHeroImage(edition);
const synthesisParagraphs = edition.article.synthesis.body.split(/\n\s*\n/u).filter(Boolean);
const sections = edition.article.sections.map((section) => {
  const signals = section.signalIds.flatMap((id) => {
    const signal = signalMap.get(id);
    return signal ? [signal] : [];
  });
  return {
    ...section,
    paragraphs: section.body.split(/\n\s*\n/u).filter(Boolean),
    signals,
    communityVoices: signals.flatMap((signal) =>
      signal.communityVoices.map((voice) => ({ signal, voice }))
    )
  };
});
const otherSignals = edition.article.otherSignalIds.flatMap((id) => {
  const signal = signalMap.get(id);
  return signal ? [signal] : [];
});
const communityVoiceCount = edition.signals.reduce(
  (total, signal) => total + signal.communityVoices.length + (signal.origin === "community" ? 1 : 0),
  0
);
const articleTags = [
  ...new Set(edition.signals.flatMap((signal) => [
    categoryLabels[signal.category] ?? signal.category,
    ...signal.topics
  ]))
];
const citations = [
  ...new Set(edition.signals.flatMap((signal) => [
    signal.source.url,
    ...signal.communityVoices.map((voice) => voice.source.url)
  ]))
];
---

<BaseLayout
  title={edition.title}
  description={edition.description}
  image={heroImage?.largeSrc}
  type="article"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "Daily Archive", path: "/daily" },
    { name: edition.editionDate, path: `/daily/${edition.editionDate}` }
  ]}
  article={{
    publishedTime: edition.generatedAt,
    modifiedTime: edition.generatedAt,
    section: "AI and developer intelligence",
    tags: articleTags,
    citations
  }}
>
  <article class="edition page-shell" data-pagefind-body>
    <header class="edition-header">
      <div class="edition-kicker">
        <span class="eyebrow">ASHFOG Daily</span>
        <span>ISSUE / {edition.editionDate.replaceAll("-", "")}</span>
      </div>
      <h1>{edition.title}</h1>
      <p>{edition.description}</p>
      <div class="edition-meta">
        <span>{formatDate(edition.editionDate)}</span>
        <span>{readingMinutes(edition)} min read</span>
        <span>{edition.signals.length} source signals</span>
        <span>{citations.length} source links</span>
        {communityVoiceCount > 0 && <span>{communityVoiceCount} community voices</span>}
      </div>
    </header>

    {heroImage && (
      <figure class="edition-cover">
        <img
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 1400px) 100vw, 1320px"
          width={heroImage.width}
          height={heroImage.height}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <aside class="edition-nav" aria-label="Edition contents">
      <span>CONTENTS</span>
      <a href="#synthesis">Synthesis</a>
      {sections.map((section) => <a href={`#${section.id}`}>{String(section.position).padStart(2, "0")}</a>)}
      {otherSignals.length > 0 && <a href="#other-signals">Other signals</a>}
      <a href="#method">Method</a>
    </aside>

    <section class="synthesis" id="synthesis" data-pagefind-meta="section:synthesis">
      <div class="synthesis-label">
        <span class="section-number">00</span>
        <span class="eyebrow">Editor&rsquo;s note</span>
      </div>
      <div class="synthesis-grid">
        <h2>{edition.article.synthesis.title}</h2>
        <div class="synthesis-copy">
          {synthesisParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <div class="article-sections">
      {sections.map((section) => (
        <section class="article-section" id={section.id} data-pagefind-meta={`section:${section.kicker}`}>
          <header class="section-header">
            <span class="section-number">{String(section.position).padStart(2, "0")}</span>
            <div>
              <span class="eyebrow">{section.kicker}</span>
              <h2>{section.title}</h2>
            </div>
          </header>

          <div class="section-content">
            <div class="prose">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <aside class="source-trail" aria-label={`Sources for ${section.title}`}>
              <span class="eyebrow">Source trail</span>
              {section.signals.map((signal) => (
                <a id={signal.id} href={signal.source.url} target="_blank" rel="noopener noreferrer">
                  <span>{String(signal.position).padStart(2, "0")}</span>
                  <strong>{signal.headline}</strong>
                  <small>{signal.source.name} ↗</small>
                </a>
              ))}
            </aside>
          </div>

          {section.communityVoices.length > 0 && (
            <aside class="community-pulse">
              <div class="community-heading">
                <span class="eyebrow">Community pulse</span>
                <strong>What people are testing and noticing</strong>
              </div>
              <div class="community-list">
                {section.communityVoices.map(({ voice }) => (
                  <div>
                    <p>{voice.summary}</p>
                    <a href={voice.source.url} target="_blank" rel="noopener noreferrer">
                      {voice.source.name} · {evidenceLabels[voice.source.evidenceLabel]} ↗
                    </a>
                  </div>
                ))}
              </div>
            </aside>
          )}
        </section>
      ))}
    </div>

    {otherSignals.length > 0 && (
      <section class="other-signals" id="other-signals">
        <header>
          <span class="eyebrow">Other signals</span>
          <h2>The rest of today&rsquo;s field notes</h2>
        </header>
        <div class="other-list">
          {otherSignals.map((signal) => (
            <article id={signal.id}>
              <span>{String(signal.position).padStart(2, "0")}</span>
              <div>
                <h3>{signal.headline}</h3>
                <p>{signal.brief}</p>
                <a href={signal.source.url} target="_blank" rel="noopener noreferrer">
                  {signal.source.name} · {evidenceLabels[signal.source.evidenceLabel]} ↗
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="method" id="method">
      <header>
        <span class="eyebrow">Method & evidence</span>
        <h2>How This Edition Is Made</h2>
      </header>
      <div class="method-grid">
        <div><b>01</b><strong>Trailing 24-hour window</strong><p>Every configured source is checked for up to 15 entries before the 09:30 New York cutoff.</p></div>
        <div><b>02</b><strong>One event, one signal</strong><p>Reports about the same underlying event are grouped by content, with the original source preferred.</p></div>
        <div><b>03</b><strong>One connected article</strong><p>Related signals become themes; community observations stay beside the event they help explain.</p></div>
        <div><b>04</b><strong>Source-linked throughout</strong><p>Every factual signal and community observation retains its collected source link.</p></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .edition { padding-top: clamp(42px, 6vw, 72px); }
  .edition-header { width: 100%; padding: 38px 0 58px; }
  .edition-kicker { display: flex; justify-content: space-between; color: var(--faint); font-size: 10px; font-weight: 680; letter-spacing: .12em; }
  .edition-header h1 { max-width: 1180px; margin: 26px 0 22px; font-size: clamp(48px, 6.5vw, 96px); font-weight: 520; letter-spacing: -.06em; line-height: 1; text-wrap: balance; }
  .edition-header > p { max-width: 700px; margin: 0; color: var(--muted); font-size: clamp(17px, 1.8vw, 20px); line-height: 1.65; }
  .edition-meta { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 28px; color: var(--faint); font-size: 11px; }
  .edition-cover { width: 100%; height: clamp(320px, 38vw, 680px); margin: 0 0 30px; overflow: hidden; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .edition-cover img { width: 100%; height: 100%; object-fit: cover; }
  .edition-nav { display: flex; width: 100%; align-items: center; gap: 20px; margin: 0 0 62px; padding: 14px 0; overflow-x: auto; border-block: 1px solid var(--line); white-space: nowrap; }
  .edition-nav span, .edition-nav a { color: var(--faint); font-size: 10px; letter-spacing: .1em; }
  .edition-nav a:hover { color: var(--ink); }
  .synthesis { width: 100%; padding: 0 0 72px; scroll-margin-top: 110px; }
  .synthesis-label { display: flex; align-items: center; gap: 14px; }
  .section-number { color: var(--accent); font-size: 13px; font-weight: 680; letter-spacing: .04em; }
  .synthesis-grid { display: grid; grid-template-columns: minmax(280px, .82fr) minmax(520px, 1.18fr); gap: clamp(48px, 6vw, 120px); align-items: start; margin-top: 24px; }
  .synthesis h2 { max-width: 720px; margin: 0; font-family: var(--font-serif); font-size: clamp(42px, 4.6vw, 76px); font-weight: 450; letter-spacing: -.04em; line-height: 1.04; text-wrap: balance; }
  .synthesis-copy { max-width: 820px; }
  .synthesis-copy p { margin: 0 0 1.35em; color: var(--muted); font-family: var(--font-serif); font-size: clamp(18px, 1.8vw, 21px); line-height: 1.75; }
  .article-sections { width: 100%; }
  .article-section { display: grid; grid-template-columns: minmax(280px, .82fr) minmax(520px, 1.18fr); gap: 0 clamp(48px, 6vw, 120px); padding: 70px 0 78px; border-top: 1px solid var(--line-strong); scroll-margin-top: 110px; }
  .section-header { display: flex; gap: 22px; align-items: start; padding: 0; }
  .section-header > div { min-width: 0; }
  .section-header h2 { max-width: 680px; margin: 12px 0 0; font-size: clamp(34px, 3.4vw, 56px); font-weight: 540; letter-spacing: -.045em; line-height: 1.08; text-wrap: balance; }
  .section-content { width: 100%; max-width: 820px; margin: 0; }
  .prose p { margin: 0 0 1.4em; color: var(--muted); font-family: var(--font-serif); font-size: clamp(18px, 1.8vw, 20px); line-height: 1.78; }
  .source-trail { margin-top: 34px; padding-top: 18px; border-top: 1px solid var(--line); }
  .source-trail > .eyebrow { display: block; margin-bottom: 4px; }
  .source-trail a { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; gap: 8px 12px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .source-trail a > span { color: var(--accent); font-size: 10px; }
  .source-trail strong { font-size: 12px; font-weight: 580; line-height: 1.45; }
  .source-trail small { color: var(--faint); font-size: 10px; white-space: nowrap; }
  .community-pulse { grid-column: 2; width: 100%; max-width: 820px; margin: 34px 0 0; padding: 24px 26px; border-left: 2px solid var(--accent); background: var(--community); }
  .community-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px 18px; margin-bottom: 18px; }
  .community-heading strong { font-family: var(--font-serif); font-size: 18px; font-weight: 450; }
  .community-list > div + div { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
  .community-list p { margin: 0 0 8px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .community-list a, .other-list a { color: var(--faint); font-size: 10px; }
  .other-signals { display: grid; grid-template-columns: minmax(280px, .82fr) minmax(520px, 1.18fr); gap: clamp(48px, 6vw, 120px); width: 100%; padding: 70px 0 78px; border-top: 1px solid var(--line-strong); scroll-margin-top: 110px; }
  .other-signals header { padding-bottom: 28px; }
  .other-signals h2 { margin: 12px 0 0; font-size: clamp(30px, 4vw, 42px); letter-spacing: -.04em; }
  .other-list { width: 100%; max-width: 820px; }
  .other-list article { display: grid; grid-template-columns: 30px 1fr; gap: 16px; padding: 28px 0; border-top: 1px solid var(--line); }
  .other-list article > span { color: var(--accent); font-size: 12px; }
  .other-list h3 { margin: 0 0 10px; font-size: 23px; letter-spacing: -.025em; line-height: 1.2; }
  .other-list p { max-width: 700px; margin: 0 0 12px; color: var(--muted); line-height: 1.7; }
  .method { display: grid; grid-template-columns: minmax(280px, .82fr) minmax(520px, 1.18fr); gap: clamp(48px, 6vw, 120px); width: 100%; margin: 10px 0 0; padding: 60px 0 20px; border-top: 1px solid var(--line-strong); scroll-margin-top: 110px; }
  .method h2 { margin: 14px 0 30px; font-size: clamp(30px, 4vw, 42px); font-weight: 540; letter-spacing: -.04em; }
  .method-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .method-grid div { min-height: 160px; padding: 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .method-grid b { display: block; margin-bottom: 18px; color: var(--accent); font-size: 11px; }
  .method-grid strong { display: block; font-size: 14px; }
  .method-grid p { margin-bottom: 0; color: var(--faint); font-size: 12px; line-height: 1.65; }
  @media (max-width: 980px) {
    .synthesis-grid,
    .article-section,
    .other-signals,
    .method { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .synthesis h2 { max-width: 780px; }
    .section-content,
    .community-pulse,
    .other-list { max-width: 780px; }
    .community-pulse { grid-column: 1; }
    .article-section { gap: 36px; }
  }
  @media (max-width: 640px) {
    .edition-header { padding-bottom: 44px; }
    .edition-kicker { align-items: start; flex-direction: column; gap: 8px; }
    .edition-header h1 { font-size: clamp(43px, 12vw, 54px); }
    .edition-cover { height: auto; aspect-ratio: 3 / 2; }
    .edition-nav { margin-bottom: 48px; }
    .synthesis { padding-bottom: 52px; }
    .synthesis h2 { font-size: clamp(34px, 10vw, 42px); }
    .article-section { padding: 50px 0 56px; }
    .section-header { gap: 14px; }
    .section-header h2 { font-size: clamp(30px, 9vw, 38px); }
    .section-content, .community-pulse { margin-left: 0; }
    .source-trail a { grid-template-columns: 22px 1fr; }
    .source-trail small { grid-column: 2; }
    .method-grid { grid-template-columns: 1fr; }
  }
</style>
