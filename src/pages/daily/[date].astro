---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categoryLabels,
  communityFindingCount,
  evidenceLabels,
  formatDate,
  getAdoptedCommunityFindings,
  getEditions,
  readingMinutes,
  type DailyEdition
} from "../../lib/daily";
import {
  getEditionHeroImage,
  getEditionStoryImages,
  getPageImage
} from "../../lib/images";

export function getStaticPaths() {
  return getEditions().map((edition) => ({
    params: { date: edition.editionDate },
    props: { edition }
  }));
}

interface Props {
  edition: DailyEdition;
}

const { edition } = Astro.props;
const storyImages = getEditionStoryImages(edition);
const heroImage = getEditionHeroImage(edition, storyImages);
const analysisImage = getPageImage("analysis");
const news = edition.stories.filter((story) => story.kind === "news");
const community = edition.stories.filter((story) => story.kind === "community");
const adoptedCommunity = getAdoptedCommunityFindings(edition);
const communityCount = communityFindingCount(edition);
const analysisParagraphs = edition.dailyAnalysis.body
  .split(/\n\s*\n/u)
  .filter(Boolean);
const articleTags = [
  ...new Set(
    edition.stories.flatMap((story) => [
      categoryLabels[story.category] ?? story.category,
      ...story.topics
    ])
  )
];
const citations = [
  ...new Set(edition.stories.map((story) => story.source.url))
];
---

<BaseLayout
  title={edition.title}
  description={edition.description}
  image={heroImage?.largeSrc}
  type="article"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "Daily Archive", path: "/daily" },
    { name: edition.editionDate, path: `/daily/${edition.editionDate}` }
  ]}
  article={{
    publishedTime: edition.generatedAt,
    modifiedTime: edition.generatedAt,
    section: "AI and developer intelligence",
    tags: articleTags,
    citations
  }}
>
  <article class="edition page-shell" data-pagefind-body>
    <header class="edition-header">
      <div class="edition-kicker">
        <span class="eyebrow">ASHFOG Daily</span>
        <span>ISSUE / {edition.editionDate.replaceAll("-", "")}</span>
      </div>
      <h1>{edition.title}</h1>
      <p>{edition.description}</p>
      <div class="edition-meta">
        <span>{formatDate(edition.editionDate)}</span>
        <span>{readingMinutes(edition)} min read</span>
        <span>{edition.stories.length} signals</span>
        <span>{edition.research.collectedUrls.length} verified links</span>
      </div>
    </header>
    {heroImage && (
      <figure class="edition-cover">
        <img
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 1400px) 100vw, 1320px"
          width={heroImage.width}
          height={heroImage.height}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <aside class="edition-nav" aria-label="Edition contents">
      <span>CONTENTS</span>
      <a href="#analysis">Synthesis</a>
      <a href="#news">Verified news <em>{news.length}</em></a>
      <a href="#community">Community findings <em>{communityCount}</em></a>
      <a href="#method">Method</a>
    </aside>

    <section class="analysis" id="analysis" data-pagefind-meta="section:analysis">
      <div class="analysis-heading">
        <div class="analysis-label">
          <span class="section-number">00</span>
          <span class="eyebrow">Editor&rsquo;s synthesis</span>
        </div>
        <h2>{edition.dailyAnalysis.title}</h2>
      </div>
      <div class="analysis-layout">
        <div class="analysis-copy">
          {analysisParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {analysisImage && (
          <figure class="analysis-figure">
            <img
              class="analysis-image"
              src={analysisImage.src}
              srcset={analysisImage.srcset}
              sizes="(max-width: 760px) 100vw, 34vw"
              width={analysisImage.width}
              height={analysisImage.height}
              alt={analysisImage.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}
      </div>
    </section>

    <section class="story-section" id="news">
      <div class="story-section-header">
        <span>01 / VERIFIED NEWS</span>
        <h2>Verified News</h2>
        <p>Official releases, repositories, policy texts, and primary research</p>
      </div>

      <div class="story-list">
        {news.map((story) => (
          <section class="story" id={story.id} data-pagefind-meta={`category:${story.category}`}>
            <div class="story-index">{String(story.position).padStart(2, "0")}</div>
            <div class="story-body">
              {storyImages.get(story.id) && (
                <img
                  class="story-image"
                  src={storyImages.get(story.id)!.src}
                  srcset={storyImages.get(story.id)!.srcset}
                  sizes="(max-width: 760px) 100vw, 850px"
                  width={storyImages.get(story.id)!.width}
                  height={storyImages.get(story.id)!.height}
                  alt={storyImages.get(story.id)!.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}              <div class="story-tags">
                <span class="tag">{categoryLabels[story.category] ?? story.category}</span>
                {story.region !== "global" && <span class="tag">{story.region.toUpperCase()}</span>}
                {story.openSource && <span class="tag open">OPEN SOURCE</span>}
                {story.highlight && <span class="tag accent">HIGHLIGHT</span>}
              </div>
              <h3>{story.headline}</h3>
              <p class="summary">{story.summary}</p>
              <div class="why">
                <strong>WHY IT MATTERS</strong>
                <p>{story.whyItMatters}</p>
              </div>
              <a class="source-link" href={story.source.url} target="_blank" rel="noopener noreferrer">
                <span>
                  <small>{evidenceLabels[story.source.evidenceLabel]}</small>
                  <strong>{story.source.name}</strong>
                </span>
                <span>View original source ↗</span>
              </a>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="story-section community" id="community">
      <div class="story-section-header">
        <span>02 / COMMUNITY LAYER</span>
        <h2>Community Findings</h2>
        <p>Only signals that can change confidence or adoption decisions</p>
      </div>

      <div class="story-list">
        {adoptedCommunity.map((signal, index) => (
          <section class="story community-finding">
            <div class="story-index">{String(index + 1).padStart(2, "0")}</div>
            <div class="story-body">
              <div class="story-tags">
                <span class="tag">COMMUNITY EVIDENCE</span>
                <span class="tag accent">{evidenceLabels[signal.evidenceLabel]}</span>
              </div>
              <h3>{signal.finding}</h3>
              {signal.configuration && (
                <div class="why">
                  <strong>TEST CONDITIONS</strong>
                  <p>{signal.configuration}</p>
                </div>
              )}
              <p class="community-context">
                Evidence attached to <a href={`#${signal.parentStoryId}`}>{signal.parentHeadline}</a>
              </p>
              <a class="source-link" href={signal.url} target="_blank" rel="noopener noreferrer">
                <span>
                  <small>{signal.authorRole}</small>
                  <strong>{signal.platform}</strong>
                </span>
                <span>View community evidence &rarr;</span>
              </a>
            </div>
          </section>
        ))}
        {community.map((story) => (
          <section class="story" id={story.id} data-pagefind-meta={`category:${story.category}`}>
            <div class="story-index">{String(story.position).padStart(2, "0")}</div>
            <div class="story-body">
              {storyImages.get(story.id) && (
                <img
                  class="story-image"
                  src={storyImages.get(story.id)!.src}
                  srcset={storyImages.get(story.id)!.srcset}
                  sizes="(max-width: 760px) 100vw, 850px"
                  width={storyImages.get(story.id)!.width}
                  height={storyImages.get(story.id)!.height}
                  alt={storyImages.get(story.id)!.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}              <div class="story-tags">
                <span class="tag">COMMUNITY</span>
                {story.region !== "global" && <span class="tag">{story.region.toUpperCase()}</span>}
                {story.openSource && <span class="tag open">OPEN SOURCE</span>}
              </div>
              <h3>{story.headline}</h3>
              <p class="summary">{story.summary}</p>
              <div class="why">
                <strong>ADOPTION SIGNAL</strong>
                <p>{story.whyItMatters}</p>
              </div>
              <a class="source-link" href={story.source.url} target="_blank" rel="noopener noreferrer">
                <span>
                  <small>{evidenceLabels[story.source.evidenceLabel]}</small>
                  <strong>{story.source.name}</strong>
                </span>
                <span>View discussion ↗</span>
              </a>
            </div>
          </section>
        ))}
        {communityCount === 0 && (
          <p class="community-empty">No community evidence met the adoption threshold in this edition. Checked surfaces and exclusions remain recorded in the research ledger.</p>
        )}
      </div>
    </section>

    <section class="method" id="method">
      <span class="eyebrow">Method & evidence</span>
      <h2>How This Edition Is Made</h2>
      <div class="method-grid">
        <div><b>01</b><strong>Trailing 24-hour window</strong><p>Every source is checked for up to 15 items published or materially updated in the 24 hours before the 09:30 New York cutoff.</p></div>
        <div><b>02</b><strong>Primary sources first</strong><p>Aggregators aid discovery; facts link to official releases, repositories, papers, policy texts, and maintainers.</p></div>
        <div><b>03</b><strong>Community evidence labeled</strong><p>Single tests, multiple-user reports, and maintainer confirmations remain distinct.</p></div>
        <div><b>04</b><strong>Validated before publication</strong><p>We check fields, word counts, dates, duplicates, sources, links, and the previous seven editions.</p></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .edition {
    position: relative;
    padding-top: 86px;
  }

  .edition-header {
    max-width: 970px;
    padding: 70px 0 90px;
  }

  .edition-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--faint);
    font-size: 10px;
    font-weight: 680;
    letter-spacing: 0.12em;
  }

  .edition-header h1 {
    max-width: 900px;
    margin: 30px 0;
    font-size: clamp(52px, 8vw, 108px);
    font-weight: 510;
    letter-spacing: -0.07em;
    line-height: 0.96;
  }

  .edition-header > p {
    max-width: 700px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(17px, 2vw, 22px);
  }

  .edition-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 40px;
    color: var(--faint);
    font-size: 11px;
  }

  .edition-cover {
    height: clamp(300px, 52vw, 650px);
    margin: 0 0 46px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .edition-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .edition-nav {
    position: sticky;
    z-index: 5;
    top: 86px;
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 60px;
    padding: 13px 18px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-raised) 92%, transparent);
    box-shadow: 0 8px 25px rgba(0,0,0,.04);
    backdrop-filter: blur(16px);
    white-space: nowrap;
  }

  .edition-nav span {
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .edition-nav a {
    color: var(--muted);
    font-size: 12px;
  }

  .edition-nav em {
    color: var(--faint);
    font-style: normal;
  }

  .analysis {
    margin: 0 0 120px;
    scroll-margin-top: 150px;
    padding: clamp(34px, 5vw, 72px);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .analysis-heading {
    max-width: 1080px;
  }

  .analysis-label {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .section-number {
    color: var(--accent);
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .analysis h2 {
    max-width: 1020px;
    margin: 28px 0 46px;
    font-family: var(--font-serif);
    font-size: clamp(40px, 5.4vw, 76px);
    font-weight: 450;
    letter-spacing: -0.045em;
    line-height: 1.04;
  }

  .analysis-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr);
    gap: clamp(36px, 6vw, 84px);
    align-items: start;
  }

  .analysis-copy {
    max-width: 760px;
  }

  .analysis-copy p {
    margin: 0 0 1.25em;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.78;
  }

  .analysis-copy p:last-child {
    margin-bottom: 0;
  }

  .analysis-figure {
    position: sticky;
    top: 160px;
    margin: 0;
  }

  .analysis-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .story-section {
    margin-bottom: 120px;
    scroll-margin-top: 150px;
  }

  .story-section-header {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    align-items: end;
    padding: 22px 0;
    border-block: 1px solid var(--line-strong);
  }

  .story-section-header span,
  .story-section-header p {
    margin: 0;
    color: var(--faint);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.11em;
  }

  .story-section-header h2 {
    margin: 0;
    font-size: 48px;
    font-weight: 530;
    letter-spacing: -0.05em;
  }

  .story-section-header p {
    justify-self: end;
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 40px;
    padding: 70px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 150px;
  }

  .story-index {
    color: var(--faint);
    font-size: clamp(52px, 7vw, 90px);
    font-weight: 480;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .story-image {
    display: block;
    width: min(100%, 850px);
    height: auto;
    margin-bottom: 30px;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .tag.open {
    background: color-mix(in srgb, var(--signal) 22%, transparent);
  }

  .tag.accent {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    color: var(--accent);
  }

  .story h3 {
    max-width: 850px;
    margin: 23px 0 25px;
    font-size: clamp(31px, 4.3vw, 58px);
    font-weight: 530;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .story .summary {
    max-width: 760px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.85;
  }

  .why {
    max-width: 760px;
    margin-top: 34px;
    padding: 22px 25px;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 56%, transparent);
  }

  .why strong {
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  .why p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .source-link {
    display: flex;
    max-width: 760px;
    align-items: center;
    justify-content: space-between;
    margin-top: 34px;
    padding: 15px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
  }

  .source-link > span:first-child {
    display: flex;
    flex-direction: column;
  }

  .source-link small {
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .source-link strong {
    color: var(--ink);
  }

  .community-context {
    max-width: 760px;
    margin: 28px 0 0;
    color: var(--faint);
    font-size: 13px;
  }

  .community-context a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .community-empty {
    max-width: 720px;
    margin: 0;
    padding: 54px 0;
    color: var(--muted);
  }

  .community {
    padding: 60px;
    border-radius: 8px;
    background: var(--community);
  }

  .method {
    padding: 90px 0;
    border-top: 1px solid var(--line-strong);
  }

  .method h2 {
    margin: 20px 0 55px;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    letter-spacing: -0.06em;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .method-grid div {
    min-height: 240px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .method-grid b {
    display: block;
    margin-bottom: 60px;
    color: var(--accent);
    font-size: 12px;
  }

  .method-grid strong {
    display: block;
    font-size: 15px;
  }

  .method-grid p {
    color: var(--muted);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .edition {
      padding-top: 20px;
    }

    .edition-nav {
      top: 78px;
      margin-inline: -4px;
    }

    .analysis {
      padding: 34px 24px;
    }

    .analysis h2 {
      margin-bottom: 34px;
      font-size: clamp(38px, 12vw, 58px);
    }

    .analysis-layout {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .analysis-figure {
      position: static;
    }

    .story-section-header {
      grid-template-columns: 1fr auto;
    }

    .story-section-header h2 {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 20px;
    }

    .story {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 50px 0;
    }

    .story-index {
      font-size: 42px;
    }

    .community {
      margin-inline: -12px;
      padding: 40px 20px;
    }

    .method-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
