---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categoryLabels,
  evidenceLabels,
  formatDate,
  getEditions,
  readingMinutes,
  type DailyEdition
} from "../../lib/daily";
import {
  getEditionHeroImage,
  getEditionStoryImages,
  getPageImage
} from "../../lib/images";

export function getStaticPaths() {
  return getEditions().map((edition) => ({
    params: { date: edition.editionDate },
    props: { edition }
  }));
}

interface Props {
  edition: DailyEdition;
}

const { edition } = Astro.props;
const storyImages = getEditionStoryImages(edition);
const heroImage = getEditionHeroImage(edition, storyImages);
const analysisImage = getPageImage("analysis");
const news = edition.stories.filter((story) => story.kind === "news");
const community = edition.stories.filter((story) => story.kind === "community");
const articleTags = [
  ...new Set(
    edition.stories.flatMap((story) => [
      categoryLabels[story.category] ?? story.category,
      ...story.topics
    ])
  )
];
const citations = [
  ...new Set(edition.stories.map((story) => story.source.url))
];
---

<BaseLayout
  title={edition.title}
  description={edition.description}
  image={heroImage?.largeSrc}
  type="article"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "日报归档", path: "/daily" },
    { name: edition.editionDate, path: `/daily/${edition.editionDate}` }
  ]}
  article={{
    publishedTime: edition.generatedAt,
    modifiedTime: edition.generatedAt,
    section: "AI 与开发者行业情报",
    tags: articleTags,
    citations
  }}
>
  <article class="edition page-shell" data-pagefind-body>
    <header class="edition-header">
      <div class="edition-kicker">
        <span class="eyebrow">ASHFOG Daily</span>
        <span>ISSUE / {edition.editionDate.replaceAll("-", "")}</span>
      </div>
      <h1>{edition.title.replace("ASHFOG Daily：", "")}</h1>
      <p>{edition.description}</p>
      <div class="edition-meta">
        <span>{formatDate(edition.editionDate)}</span>
        <span>{readingMinutes(edition)} 分钟信号</span>
        <span>{edition.stories.length} 条动态</span>
        <span>{edition.research.collectedUrls.length} 个核验链接</span>
      </div>
    </header>
    {heroImage && (
      <figure class="edition-cover">
        <img
          src={heroImage.src}
          srcset={heroImage.srcset}
          sizes="(max-width: 1400px) 100vw, 1320px"
          width={heroImage.width}
          height={heroImage.height}
          alt={heroImage.alt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    <aside class="edition-nav" aria-label="本期目录">
      <span>本期目录</span>
      <a href="#analysis">编辑综述</a>
      <a href="#news">要点新闻 <em>{news.length}</em></a>
      <a href="#community">社区动态 <em>{community.length}</em></a>
      <a href="#method">来源说明</a>
    </aside>

    <section class="analysis" id="analysis" data-pagefind-meta="section:analysis">
      <div class="section-number">00</div>
      <div>
        <span class="eyebrow">Editor’s synthesis</span>
        <h2>{edition.dailyAnalysis.title}</h2>
        <p>{edition.dailyAnalysis.body}</p>
      </div>
      {analysisImage && (
        <img
          class="analysis-image"
          src={analysisImage.src}
          srcset={analysisImage.srcset}
          sizes="(max-width: 760px) 100vw, 32vw"
          width={analysisImage.width}
          height={analysisImage.height}
          alt={analysisImage.alt}
          loading="lazy"
          decoding="async"
        />
      )}
    </section>

    <section class="story-section" id="news">
      <div class="story-section-header">
        <span>01 / VERIFIED NEWS</span>
        <h2>要点新闻</h2>
        <p>官方发布、仓库版本与一手研究</p>
      </div>

      <div class="story-list">
        {news.map((story) => (
          <section class="story" id={story.id} data-pagefind-meta={`category:${story.category}`}>
            <div class="story-index">{String(story.position).padStart(2, "0")}</div>
            <div class="story-body">
              {storyImages.get(story.id) && (
                <img
                  class="story-image"
                  src={storyImages.get(story.id)!.src}
                  srcset={storyImages.get(story.id)!.srcset}
                  sizes="(max-width: 760px) 100vw, 850px"
                  width={storyImages.get(story.id)!.width}
                  height={storyImages.get(story.id)!.height}
                  alt={storyImages.get(story.id)!.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}              <div class="story-tags">
                <span class="tag">{categoryLabels[story.category] ?? story.category}</span>
                {story.openSource && <span class="tag open">OPEN SOURCE</span>}
                {story.highlight && <span class="tag accent">HIGHLIGHT</span>}
              </div>
              <h3>{story.headline}</h3>
              <p class="summary">{story.summary}</p>
              <div class="why">
                <strong>WHY IT MATTERS</strong>
                <p>{story.whyItMatters}</p>
              </div>
              <a class="source-link" href={story.source.url} target="_blank" rel="noopener noreferrer">
                <span>
                  <small>{evidenceLabels[story.source.evidenceLabel]}</small>
                  <strong>{story.source.name}</strong>
                </span>
                <span>查看原始来源 ↗</span>
              </a>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="story-section community" id="community">
      <div class="story-section-header">
        <span>02 / COMMUNITY LAYER</span>
        <h2>社区动态</h2>
        <p>只收录会改变采用与判断的信号</p>
      </div>

      <div class="story-list">
        {community.map((story) => (
          <section class="story" id={story.id} data-pagefind-meta={`category:${story.category}`}>
            <div class="story-index">{String(story.position).padStart(2, "0")}</div>
            <div class="story-body">
              {storyImages.get(story.id) && (
                <img
                  class="story-image"
                  src={storyImages.get(story.id)!.src}
                  srcset={storyImages.get(story.id)!.srcset}
                  sizes="(max-width: 760px) 100vw, 850px"
                  width={storyImages.get(story.id)!.width}
                  height={storyImages.get(story.id)!.height}
                  alt={storyImages.get(story.id)!.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}              <div class="story-tags">
                <span class="tag">COMMUNITY</span>
                {story.openSource && <span class="tag open">OPEN SOURCE</span>}
              </div>
              <h3>{story.headline}</h3>
              <p class="summary">{story.summary}</p>
              <div class="why">
                <strong>ADOPTION SIGNAL</strong>
                <p>{story.whyItMatters}</p>
              </div>
              <a class="source-link" href={story.source.url} target="_blank" rel="noopener noreferrer">
                <span>
                  <small>{evidenceLabels[story.source.evidenceLabel]}</small>
                  <strong>{story.source.name}</strong>
                </span>
                <span>查看讨论现场 ↗</span>
              </a>
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="method" id="method">
      <span class="eyebrow">Method & evidence</span>
      <h2>这份日报如何生成</h2>
      <div class="method-grid">
        <div><b>01</b><strong>48 小时时间窗</strong><p>只收录截止时间前两天内的实质更新，旧闻必须注明重大变化。</p></div>
        <div><b>02</b><strong>回到原始来源</strong><p>聚合器只用于发现，事实优先链接官方公告、仓库、论文和维护者说明。</p></div>
        <div><b>03</b><strong>社区证据分级</strong><p>单次测试、多用户报告与维护者确认不会混为一谈。</p></div>
        <div><b>04</b><strong>发布前验证</strong><p>检查字段、日期、重复项、来源数量、链接与最近七期事件。</p></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .edition {
    position: relative;
    padding-top: 86px;
  }

  .edition-header {
    max-width: 970px;
    padding: 70px 0 90px;
  }

  .edition-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--faint);
    font-size: 10px;
    font-weight: 680;
    letter-spacing: 0.12em;
  }

  .edition-header h1 {
    max-width: 900px;
    margin: 30px 0;
    font-size: clamp(52px, 8vw, 108px);
    font-weight: 510;
    letter-spacing: -0.07em;
    line-height: 0.96;
  }

  .edition-header > p {
    max-width: 700px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(17px, 2vw, 22px);
  }

  .edition-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 40px;
    color: var(--faint);
    font-size: 11px;
  }

  .edition-cover {
    height: clamp(300px, 52vw, 650px);
    margin: 0 0 46px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }

  .edition-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .edition-nav {
    position: sticky;
    z-index: 5;
    top: 86px;
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 60px;
    padding: 13px 18px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-raised) 92%, transparent);
    box-shadow: 0 8px 25px rgba(0,0,0,.04);
    backdrop-filter: blur(16px);
    white-space: nowrap;
  }

  .edition-nav span {
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .edition-nav a {
    color: var(--muted);
    font-size: 12px;
  }

  .edition-nav em {
    color: var(--faint);
    font-style: normal;
  }

  .analysis {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr) minmax(240px, .7fr);
    gap: 40px;
    margin: 0 0 120px;
    padding: 70px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface-raised);
    box-shadow: var(--shadow);
  }

  .section-number {
    color: var(--accent);
    font-size: 74px;
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .analysis h2 {
    max-width: 760px;
    margin: 20px 0 28px;
    font-family: var(--font-serif);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 450;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .analysis p {
    max-width: 780px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.9;
  }

  .analysis-image {
    width: 100%;
    height: 100%;
    max-height: 360px;
    align-self: center;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .story-section {
    margin-bottom: 120px;
    scroll-margin-top: 150px;
  }

  .story-section-header {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    align-items: end;
    padding: 22px 0;
    border-block: 1px solid var(--line-strong);
  }

  .story-section-header span,
  .story-section-header p {
    margin: 0;
    color: var(--faint);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.11em;
  }

  .story-section-header h2 {
    margin: 0;
    font-size: 48px;
    font-weight: 530;
    letter-spacing: -0.05em;
  }

  .story-section-header p {
    justify-self: end;
  }

  .story {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 40px;
    padding: 70px 0;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 150px;
  }

  .story-index {
    color: var(--faint);
    font-size: clamp(52px, 7vw, 90px);
    font-weight: 480;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .story-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .story-image {
    display: block;
    width: min(100%, 850px);
    height: auto;
    margin-bottom: 30px;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .tag.open {
    background: color-mix(in srgb, var(--signal) 22%, transparent);
  }

  .tag.accent {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    color: var(--accent);
  }

  .story h3 {
    max-width: 850px;
    margin: 23px 0 25px;
    font-size: clamp(31px, 4.3vw, 58px);
    font-weight: 530;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .story .summary {
    max-width: 760px;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.85;
  }

  .why {
    max-width: 760px;
    margin-top: 34px;
    padding: 22px 25px;
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 56%, transparent);
  }

  .why strong {
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  .why p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .source-link {
    display: flex;
    max-width: 760px;
    align-items: center;
    justify-content: space-between;
    margin-top: 34px;
    padding: 15px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
  }

  .source-link > span:first-child {
    display: flex;
    flex-direction: column;
  }

  .source-link small {
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .source-link strong {
    color: var(--ink);
  }

  .community {
    padding: 60px;
    border-radius: 8px;
    background: var(--community);
  }

  .method {
    padding: 90px 0;
    border-top: 1px solid var(--line-strong);
  }

  .method h2 {
    margin: 20px 0 55px;
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 520;
    letter-spacing: -0.06em;
  }

  .method-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .method-grid div {
    min-height: 240px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .method-grid b {
    display: block;
    margin-bottom: 60px;
    color: var(--accent);
    font-size: 12px;
  }

  .method-grid strong {
    display: block;
    font-size: 15px;
  }

  .method-grid p {
    color: var(--muted);
    font-size: 12px;
  }

  @media (max-width: 760px) {
    .edition {
      padding-top: 20px;
    }

    .edition-nav {
      top: 78px;
      margin-inline: -4px;
    }

    .analysis {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 34px 24px;
    }

    .analysis-image {
      max-height: none;
    }

    .section-number {
      font-size: 48px;
    }

    .story-section-header {
      grid-template-columns: 1fr auto;
    }

    .story-section-header h2 {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: 20px;
    }

    .story {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 50px 0;
    }

    .story-index {
      font-size: 42px;
    }

    .community {
      margin-inline: -12px;
      padding: 40px 20px;
    }

    .method-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
