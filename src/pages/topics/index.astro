---
import PageArtwork from "../../components/PageArtwork.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabels, getArticles } from "../../lib/articles";
import { getPageImage } from "../../lib/images";

const articles = await getArticles();
const topics = Object.entries(categoryLabels).map(([slug, label]) => ({
  slug,
  label,
  count: articles.filter((article) => article.data.category === slug).length
}));
const pageImage = getPageImage("topics");
---

<BaseLayout
  title="Topics"
  description="Explore ASHFOG articles by model, agent, open-source, infrastructure, research, hardware, security, and policy topic."
  image={pageImage?.largeSrc}
  pageType="CollectionPage"
  breadcrumbs={[{ name: "ASHFOG", path: "/" }, { name: "Topics", path: "/topics" }]}
>
  <section class="topics page-shell">
    <header>
      <span class="eyebrow">Topic index</span>
      <h1>Follow the ideas<br /><em>behind the releases</em></h1>
      <p>Browse focused writing across the technical and cultural layers of artificial intelligence.</p>
    </header>
    {pageImage && <PageArtwork image={pageImage} priority />}
    <div class="topic-grid">
      {topics.map((topic, index) => (
        <a href={`/topics/${topic.slug}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h2>{topic.label}</h2>
          <p>{topic.count === 1 ? "1 article" : `${topic.count} articles`}</p>
          <i>↗</i>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .topics { padding-top: 76px; }
  header { display: grid; min-height: 330px; grid-template-columns: 1.45fr .55fr; align-items: end; gap: 60px; padding-bottom: 58px; }
  .eyebrow { grid-column: 1 / -1; align-self: start; }
  h1 { margin: 0; font-size: clamp(48px, 6.5vw, 86px); font-weight: 510; letter-spacing: -.07em; line-height: .96; }
  h1 em { color: var(--accent); font-family: var(--font-serif); font-weight: 430; }
  header p { margin: 0; color: var(--muted); line-height: 1.75; }
  .topic-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .topic-grid a { position: relative; min-height: 240px; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); }
  .topic-grid a:hover { background: var(--surface-raised); }
  .topic-grid > a > span, .topic-grid p { color: var(--faint); font-size: 11px; }
  .topic-grid h2 { margin: 70px 0 8px; font-size: clamp(26px, 3vw, 40px); font-weight: 540; letter-spacing: -.045em; }
  .topic-grid i { position: absolute; right: 24px; bottom: 24px; color: var(--accent); font-style: normal; }
  @media (max-width: 820px) { header { grid-template-columns: 1fr; min-height: 0; gap: 28px; } .topic-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .topic-grid { grid-template-columns: 1fr; } }
</style>
