---
import PageArtwork from "../../components/PageArtwork.astro";
import { getPageImage } from "../../lib/images";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabels, getAllTopics, getStoriesByTopic } from "../../lib/daily";

const topics = getAllTopics();
const pageImage = getPageImage("topics");
---

<BaseLayout
  title="主题索引"
  description="按主题浏览 ASHFOG 每日行业情报。"
  image={pageImage?.largeSrc}
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "ASHFOG", path: "/" },
    { name: "主题索引", path: "/topics" }
  ]}
>
  <section class="topics page-shell">
    <header>
      <span class="eyebrow">Topic index</span>
      <h1>主题不是栏目<br />是持续变化的<strong>信号场</strong></h1>
    </header>
    {pageImage && <PageArtwork image={pageImage} priority />}

    <div class="topic-grid">
      {topics.map((topic, index) => {
        const count = getStoriesByTopic(topic).length;
        return (
          <a href={`/topics/${topic}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h2>{categoryLabels[topic] ?? topic}</h2>
            <p>{count} 条已归档信号</p>
            <i>↗</i>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .topics {
    padding-top: 130px;
  }

  header {
    min-height: 450px;
  }

  h1 {
    max-width: 950px;
    margin: 35px 0 0;
    font-size: clamp(50px, 8vw, 104px);
    font-weight: 510;
    letter-spacing: -0.07em;
    line-height: 0.96;
  }

  h1 strong {
    color: var(--accent);
    font-family: var(--font-serif);
    font-weight: 430;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .topic-grid a {
    position: relative;
    min-height: 290px;
    padding: 26px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .topic-grid a:hover {
    background: var(--surface-raised);
  }

  .topic-grid span,
  .topic-grid p {
    color: var(--faint);
    font-size: 11px;
  }

  .topic-grid h2 {
    margin: 100px 0 8px;
    font-size: 38px;
    font-weight: 530;
    letter-spacing: -0.05em;
  }

  .topic-grid i {
    position: absolute;
    top: 24px;
    right: 26px;
    color: var(--accent);
    font-style: normal;
  }

  @media (max-width: 800px) {
    .topic-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
