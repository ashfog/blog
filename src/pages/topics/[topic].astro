---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  categoryLabels,
  formatDate,
  getAllTopics,
  getStoriesByTopic
} from "../../lib/daily";

export function getStaticPaths() {
  return getAllTopics().map((topic) => ({
    params: { topic },
    props: { topic }
  }));
}

const { topic } = Astro.props;
const items = getStoriesByTopic(topic);
const title = categoryLabels[topic] ?? topic;
---

<BaseLayout title={`${title}主题`} description={`AshFog ${title}主题信号归档。`}>
  <section class="topic-page page-shell">
    <header>
      <a href="/topics">← 所有主题</a>
      <span>{String(items.length).padStart(2, "0")} SIGNALS</span>
      <h1>{title}</h1>
    </header>

    <div class="items">
      {items.map(({ story, edition }, index) => (
        <a href={`/daily/${edition.editionDate}#${story.id}`}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <small>{formatDate(edition.editionDate)} · {story.source.name}</small>
            <h2>{story.headline}</h2>
            <p>{story.summary}</p>
          </div>
          <i>↗</i>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .topic-page {
    padding-top: 120px;
  }

  header {
    position: relative;
    min-height: 390px;
    border-bottom: 1px solid var(--line-strong);
  }

  header a,
  header span {
    color: var(--faint);
    font-size: 11px;
  }

  header span {
    position: absolute;
    right: 0;
  }

  h1 {
    position: absolute;
    bottom: 30px;
    margin: 0;
    font-size: clamp(80px, 15vw, 190px);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: .8;
  }

  .items a {
    display: grid;
    grid-template-columns: 70px 1fr 30px;
    gap: 30px;
    padding: 44px 10px;
    border-bottom: 1px solid var(--line);
  }

  .items > a > span,
  small {
    color: var(--faint);
    font-size: 10px;
  }

  h2 {
    max-width: 900px;
    margin: 8px 0 12px;
    font-size: clamp(25px, 3.5vw, 45px);
    font-weight: 530;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .items p {
    max-width: 700px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
  }

  .items i {
    color: var(--accent);
    font-style: normal;
  }
</style>
