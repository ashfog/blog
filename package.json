{
  "name": "ashfog-blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build:astro": "astro build",
    "build:search": "pagefind --site dist",
    "build:seo": "node scripts/validate-seo.mjs",
    "build": "pnpm run build:astro && pnpm run build:search && pnpm run build:seo",
    "preview": "astro preview",
    "validate:daily": "node scripts/validate-daily.mjs",
    "test:editorial": "node --test tests/validate-daily.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "pagefind": "^1.5.2"
  }
}
